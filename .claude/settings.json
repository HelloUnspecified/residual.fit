{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ASTRO_TELEMETRY_DISABLED": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run preview)",
      "Bash(npm run og)",
      "Bash(fnm exec --using=.node-version npm run *)",
      "Bash(npm ls *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "WebFetch(domain:docs.astro.build)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:loops.so)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev.vars)",
      "Edit(./public/og.png)"
    ]
  }
}

---
import Phone from './Phone.astro';

const stages = [
  { id: 'targets', clause: 'Set targets with a range.', body: 'Bring your own numbers, or work them out in the app from your body, activity and goal. Each gets its own ± band, and landing anywhere inside it counts.', shot: '05-targets', alt: 'The Daily targets screen: calories 2,100, protein 150, carbs 220 and fat 70, each with its own range, fat floating, and a line that says what the macros add up to.' },
  { id: 'plan', clause: 'Plan the day first.', body: 'Claude drafts it from your pantry and what you tell it, if you allow it; otherwise your iPhone does. Every plan says who wrote it. You pick each food\'s real match, and an estimate shows as one until you do.', shot: '02b-proposal', alt: 'A proposed plan by Claude: breakfast, lunch, snack and dinner with their foods, grams and totals, ready to accept.' },
  { id: 'log', clause: 'Log what you really ate.', body: 'Amounts start from the plan. Swipe a meal to log it as planned, or open it and change what differed. The plan stays exactly as it was.', shot: '04-log', alt: 'Lunch open to log, marked Logging · In progress: a table of plan, ate and drift, each food with its amount and a stepper, the chicken a little over the plan, and a button that logs the meal.' },
  { id: 'solve', clause: 'The rest re-sizes to land.', body: 'A deterministic solver re-sizes the meals ahead by the smallest plausible change, and the screen says where the day lands before you eat it.', shot: '03a-drift', alt: 'Today after lunch ran over: the ring turns amber past its range, the verdict names what is over, and one button says Close the residual.' },
];
---
<section id="how" class="how wrap" aria-labelledby="how-title">
  <div class="frame how__grid">
    <div class="how__index">
      <h2 id="how-title" class="head" data-reveal>How a day goes</h2>
      <ol class="how__list">
        {stages.map((s, i) => (
          <li class="how__row" data-stage={i} data-reveal style={`--i:${i + 1}`} aria-current={i === 0 ? 'step' : undefined}>
            <h3 class="title"><button type="button" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`how-shot-${i}`}>{s.clause}</button></h3>
            <p class="how__body"><span>{s.body}</span></p>
          </li>
        ))}
      </ol>
    </div>
    <div class="how__frame" data-reveal="scale">
      {stages.map((s, i) => (
        <figure class:list={['how__shot', { 'is-on': i === 0 }]} id={`how-shot-${i}`} data-stage={i}>
          <Phone name={s.shot} alt={s.alt} sizes="(min-width: 64em) 24rem, 70vw" />
        </figure>
      ))}
    </div>
  </div>
</section>

<script>
  const root = document.querySelector('.how');
  if (root) {
    const rows = [...root.querySelectorAll<HTMLElement>('.how__row')];
    const shots = [...root.querySelectorAll<HTMLElement>('.how__shot')];
    let current = 0;
    const show = (i: number) => {
      current = i;
      rows.forEach((r, k) => { if (k === i) r.setAttribute('aria-current', 'step'); else r.removeAttribute('aria-current'); r.querySelector('button')!.setAttribute('aria-expanded', k === i ? 'true' : 'false'); });
      shots.forEach((s, k) => s.classList.toggle('is-on', k === i));
    };
    rows.forEach((r, i) => {
      r.querySelector('button')!.addEventListener('click', () => { touched = true; show(i); });
      r.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') { touched = true; show(i); } });
    });
    // Walk through once, slowly, until the visitor touches it. Never with reduced motion.
    let touched = false;
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const io = new IntersectionObserver((entries) => {
        if (!entries[0].isIntersecting) return;
        io.disconnect();
        const tick = () => { if (touched || current >= 3) return; show(current + 1); setTimeout(tick, 3600); };
        setTimeout(tick, 3600);
      }, { threshold: 0.5 });
      io.observe(root);
    }
  }
</script>

<style>
  .how { margin-top: var(--section); }
  .how__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 24rem); column-gap: clamp(2rem, 7vw, 7rem); align-items: center; }
  .how__list { margin-top: 2.5rem; display: grid; gap: 0.25rem; }
  .how__row { padding: 0.9rem 0; }
  .how__row button { text-align: left; color: var(--label2); font: inherit; letter-spacing: inherit; transition: color var(--t-hover) ease; }
  .how__row[aria-current] button { color: var(--text); }
  @media (hover: hover) and (pointer: fine) { .how__row button:hover { color: var(--text); } }
  .how__body { display: grid; grid-template-rows: 0fr; overflow: hidden; max-width: 46ch; opacity: 0; transition: grid-template-rows 320ms var(--ease-out), opacity 320ms ease, margin-top 320ms var(--ease-out); }
  .how__body > span { display: block; min-height: 0; overflow: hidden; }
  .how__row[aria-current] .how__body { grid-template-rows: 1fr; opacity: 1; margin-top: 0.6rem; }

  .how__frame { display: grid; }
  .how__shot { grid-area: 1 / 1; opacity: 0; transform: translateY(10px); transition: opacity 240ms ease, transform 500ms var(--ease-out); }
  .how__shot.is-on { opacity: 1; transform: none; }

  @media (max-width: 64em) {
    .how__grid { grid-template-columns: minmax(0, 1fr); row-gap: 2.5rem; }
    .how__frame { order: 2; width: min(78vw, 22rem); margin-inline: auto; }
  }
</style>

---
import { Image } from 'astro:assets';
import Ring from './Ring.astro';
import { site } from '../site';
import today from '../assets/shots/today-dark.png';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__inner">
    <div class="hero__copy">
      <h1 id="hero-title" class="display lines">
        <span class="line"><span data-line style="--i:0">A day of eating,</span></span>
        <span class="line"><span data-line style="--i:1">solved.</span></span>
      </h1>
      <p class="lead" data-rise style="--i:2">Set the numbers your nutritionist gave you. Plan with Claude, log what you really ate, and Residual re-sizes the meals ahead so the day lands in range.</p>
      <div class="hero__actions" data-rise style="--i:3">
        <a class="button" href={site.appStoreUrl}><Ring size="1.1em" width={0.2} tick={false} dot={false} eaten={0.62} lands={0.93} zoneStart={0.84} /> Get Residual on the App Store</a>
        <a class="link hero__try" href="#live">Or try the solver first</a>
      </div>
      <p class="small muted hero__note" data-rise style="--i:4">iPhone · {site.minimumOS} · Your data stays on your phone and in your iCloud.</p>
    </div>
    <div class="hero__stage" aria-hidden="true">
      <div class="hero__ringbox">
        <Ring class="ring--animate" size="100%" eaten={0.62} lands={0.93} zoneStart={0.84} width={0.12} tickLength={0.7} />
      </div>
      <div class="hero__screen">
        <Image src={today} alt="" widths={[420, 640, 900]} sizes="(min-width: 64em) 26svh, 60vw" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </div>
</section>

<style>
  /* One contained composition: the copy and the ring share a 1600px frame so they sit together on a
     wide screen instead of drifting to opposite edges. The stage sets the height; the copy centres on it. */
  .hero { position: relative; min-height: 100svh; display: grid; align-items: center; overflow: clip; padding: 5rem var(--margin) 1.5rem; }
  .hero__inner { width: 100%; max-width: 1600px; margin-inline: auto; display: grid; grid-template-columns: minmax(0, 11fr) minmax(0, 9fr); column-gap: var(--gutter); align-items: center; }
  .hero__copy { max-width: 40rem; }
  .hero__copy h1 { max-width: 16ch; font-size: clamp(3rem, 5.6vw, 5.5rem); }
  .lead { margin-top: 1.4rem; max-width: 36ch; font-size: clamp(1.125rem, 1rem + 0.6vw, 1.4rem); }
  .hero__actions { margin-top: 2rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; }
  .hero__try { font-weight: 500; }
  .hero__note { margin-top: 1.4rem; }

  /* The ring is the stage; the real Today screen stands whole in its lower half, so the tick, the range
     and the landing dot stay in view while the ring draws itself in. */
  .hero__stage { position: relative; height: 86svh; min-height: 540px; }
  .hero__ringbox { position: absolute; left: 50%; top: 44%; width: min(116svh, 128%); aspect-ratio: 1; transform: translate(-50%, -50%); color: var(--ink); }
  .hero__screen { position: absolute; left: 50%; top: 44%; width: min(24svh, 36%); aspect-ratio: 1206 / 2622; transform: translate(-50%, -6%); border-radius: 9% / 4.2%; overflow: hidden; }
  .hero__screen img { width: 100%; height: 100%; object-fit: cover; }

  @media (prefers-reduced-motion: no-preference) {
    .js .hero__screen { opacity: 0; transform: translate(-50%, -2%) scale(0.98); animation: settle 900ms var(--ease-out) 1100ms forwards; }
    @supports (animation-timeline: scroll()) {
      .hero__stage { animation: turn linear both; animation-timeline: scroll(root); animation-range: 0 100vh; }
    }
  }
  @keyframes settle { to { opacity: 1; transform: translate(-50%, -6%) scale(1); } }
  @keyframes turn { to { transform: translateY(-6vh); } }

  @media (max-width: 64em) {
    .hero { align-items: start; padding-top: 5rem; }
    .hero__inner { grid-template-columns: minmax(0, 1fr); row-gap: 1rem; }
    .hero__stage { height: auto; min-height: 0; aspect-ratio: 1 / 1.1; width: min(100%, 72vh); margin-inline: auto; }
    .hero__ringbox { width: 100%; top: 46%; }
    .hero__screen { width: 26%; top: 46%; }
    @supports (animation-timeline: scroll()) { .hero__stage { animation: none; } }
  }
  @media (max-width: 40em) {
    .hero__copy h1 { max-width: none; font-size: 2.65rem; }
    .hero__stage { width: 100%; }
    .hero__screen { width: 30%; }
  }
</style>

---
// Search the help, on Pagefind's index of the articles (built after `astro build`; see package.json). The index
// and its WebAssembly load on the field's first focus, not with the page. Without JavaScript the field isn't drawn
// at all, since it couldn't do anything: the section cards under it are the way in, and they hold every article.
---
<form class="search" role="search" data-help-search>
  <label class="sr-only" for="help-q">Search help</label>
  <div class="search__field">
    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="2" /><path d="m13 13 4.5 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    <input id="help-q" name="q" type="search" placeholder="Search help" autocomplete="off" spellcheck="false" aria-describedby="help-q-count" aria-controls="help-q-results" />
  </div>
  <div class="search__results" id="help-q-results">
    <p class="search__count small muted" id="help-q-count" role="status" data-count></p>
    <div data-list></div>
  </div>
</form>

<script>
  // Pagefind's own bundle, written by `pagefind --site dist/client` after the build. Not a module Vite can see,
  // so it's imported by a runtime URL. In `npm run dev` it doesn't exist; the panel says search isn't available.
  type Hit = { url: string; excerpt: string; meta: { title?: string; section?: string; description?: string } };
  type Pagefind = {
    options: (o: Record<string, unknown>) => Promise<void>;
    init: () => Promise<void>;
    debouncedSearch: (q: string, o?: object, ms?: number) => Promise<{ results: { data: () => Promise<Hit> }[] } | null>;
  };

  const form = document.querySelector<HTMLFormElement>('[data-help-search]');
  if (form) {
    const input = form.querySelector('input')!;
    const count = form.querySelector<HTMLElement>('[data-count]')!;
    const list = form.querySelector<HTMLElement>('[data-list]')!;
    const bundle = '/pagefind/pagefind.js';
    let pagefind: Promise<Pagefind> | undefined;
    const load = () => (pagefind ??= import(/* @vite-ignore */ bundle).then(async (pf: Pagefind) => {
      await pf.options({ excerptLength: 24 });
      await pf.init();
      return pf;
    }));

    const results = () => [...list.querySelectorAll<HTMLAnchorElement>('a')];
    const setOpen = (open: boolean) => form.classList.toggle('is-open', open && input.value.trim() !== '');

    const render = (q: string, total: number, hits: Hit[]) => {
      const quoted = `“${q}”`;
      count.textContent = total === 0
        ? `No articles mention ${quoted}. Try another word, or browse the topics below.`
        : `${total} ${total === 1 ? 'article mentions' : 'articles mention'} ${quoted}`;
      list.replaceChildren(...hits.map((hit) => {
        const a = document.createElement('a');
        a.className = 'result';
        a.href = hit.url;
        const title = document.createElement('span');
        title.className = 'result__title';
        title.textContent = hit.meta.title ?? hit.url;
        const where = document.createElement('span');
        where.className = 'result__where kicker';
        where.textContent = hit.meta.section ?? '';
        const text = document.createElement('span');
        text.className = 'result__text';
        // Pagefind's excerpt is the article's own text, escaped, with the matched words in <mark>.
        if (hit.excerpt) text.innerHTML = hit.excerpt; else text.textContent = hit.meta.description ?? '';
        a.append(title, where, text);
        return a;
      }));
    };

    const run = async () => {
      const q = input.value.trim();
      if (!q) { count.textContent = ''; list.replaceChildren(); setOpen(false); return; }
      setOpen(true);
      let pf: Pagefind;
      try { pf = await load(); } catch {
        count.textContent = 'Search isn’t available right now. Every article is listed below.';
        list.replaceChildren();
        return;
      }
      const search = await pf.debouncedSearch(q, {}, 180);
      // A newer keystroke superseded this search; its own run draws the panel.
      if (!search || input.value.trim() !== q) return;
      render(q, search.results.length, await Promise.all(search.results.slice(0, 6).map((r) => r.data())));
    };

    input.addEventListener('focus', () => { load().catch(() => {}); }, { once: true });
    input.addEventListener('input', run);
    form.addEventListener('focusin', () => setOpen(true));
    // Close once focus has left the field and its results, not while it moves between them.
    form.addEventListener('focusout', () => requestAnimationFrame(() => { if (!form.contains(document.activeElement)) setOpen(false); }));
    // Enter goes to the first result, the way a search field on a help site is expected to.
    form.addEventListener('submit', (e) => { e.preventDefault(); results()[0]?.click(); });

    form.addEventListener('keydown', (e) => {
      const links = results();
      const at = links.indexOf(document.activeElement as HTMLAnchorElement);
      if (e.key === 'Escape') {
        // Focus first: moving it back to the field from a result fires focusin, which would reopen the panel.
        if (form.classList.contains('is-open')) { e.preventDefault(); input.focus(); form.classList.remove('is-open'); }
      } else if (e.key === 'ArrowDown' && links.length) {
        e.preventDefault();
        setOpen(true);
        links[Math.min(at + 1, links.length - 1)].focus();
      } else if (e.key === 'ArrowUp' && at >= 0) {
        e.preventDefault();
        (at === 0 ? input : links[at - 1]).focus();
      }
    });
  }
</script>

<style>
  /* Drawn only with JavaScript: without it the field couldn't search, and a control that does nothing is worse
     than none. The section cards below carry the page. */
  .search { display: none; position: relative; margin-top: 2rem; max-width: 40rem; }
  :global(.js) .search { display: block; }
  .search__field { position: relative; }
  .search__field svg { position: absolute; left: 1.15rem; top: 50%; transform: translateY(-50%); color: var(--label3); pointer-events: none; }
  .search input { width: 100%; min-height: 3.5rem; padding: 0 1.25rem 0 3.1rem; border: 0; border-radius: 999px; background: var(--card); color: var(--text); font-size: max(1rem, var(--step-body)); }
  .search input::placeholder { color: var(--label3); }
  .search input::-webkit-search-cancel-button { display: none; }

  /* The results float over the cards while the field or a result has focus and something is typed. */
  .search__results { display: none; position: absolute; z-index: 5; top: calc(100% + 0.5rem); left: 0; right: 0; background: var(--card); border-radius: var(--radius-card); padding: 0.75rem clamp(1rem, 2vw, 1.5rem) 1rem; box-shadow: 0 10px 30px rgb(0 0 0 / 0.18); }
  .search.is-open .search__results { display: block; }
  .search__count { padding-block: 0.25rem 0.5rem; }
  .search__count:empty { display: none; }

  /* Results are built by the script, so their styles reach past this component's scope. A match is marked by
     weight, not color: the excerpt stays one gray, the words you typed in the text's own color, bolder. */
  .search :global(.result) { display: block; padding-block: 0.85rem; text-decoration: none; border-top: 1px solid var(--separator); }
  .search :global(.result__title) { display: block; font-weight: 600; line-height: 1.3; }
  .search :global(.result__where) { display: block; margin-top: 0.15rem; }
  .search :global(.result__where:empty) { display: none; }
  .search :global(.result__text) { display: block; margin-top: 0.3rem; color: var(--label2); font-size: var(--step-small); line-height: 1.45; }
  .search :global(.result mark) { background: none; color: var(--text); font-weight: 600; }
  .search :global(.result:focus-visible) { outline-offset: 0; border-radius: 10px; }
  @media (hover: hover) and (pointer: fine) {
    .search :global(.result:hover .result__title) { color: var(--key); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .search.is-open .search__results { animation: help-open var(--t-ui) var(--ease-out); }
  }
  @keyframes help-open { from { opacity: 0; transform: translateY(-4px); } }
</style>

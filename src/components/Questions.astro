---
import { faq } from '../content/faq';
---
<section id="questions" class="faq wrap" aria-labelledby="faq-title">
  <div class="frame faq__grid">
    <h2 id="faq-title" class="head" data-reveal>Questions</h2>
    <!-- A grouped list, the way Settings draws one. Native disclosure, so it works without script, and `name` lets
         one answer open at a time where the browser supports it. -->
    <div class="faq__list" data-reveal>
      {faq.map((c, i) => (
        <details name="faq" open={i === 0}>
          <summary><span>{c.q}</span><svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2 4.25 6 8.25l4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
          <div class="faq__a"><p>{c.a}</p>{c.more && <a class="link" href={c.more.href}>{c.more.label}</a>}</div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { margin-top: var(--section); }
  .faq__grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); column-gap: var(--gutter); align-items: start; }
  .faq__list { background: var(--card); border-radius: var(--radius-card); padding-inline: clamp(1rem, 2vw, 1.5rem); }
  details + details { border-top: 1px solid var(--separator); }
  summary { display: flex; justify-content: space-between; align-items: center; gap: 1rem; min-height: 3.5rem; padding-block: 0.8rem; cursor: pointer; list-style: none; font-weight: 600; font-size: 1.0625rem; line-height: 1.3; }
  summary::-webkit-details-marker { display: none; }
  summary svg { flex: none; color: var(--label3); transition: transform var(--t-ui) var(--ease-out); }
  details[open] summary svg { transform: rotate(180deg); }
  .faq__a { padding-bottom: 1.25rem; }
  .faq__a p { color: var(--label2); max-width: 62ch; }
  .faq__a .link { display: inline-block; margin-top: 0.6rem; }
  @media (max-width: 64em) {
    .faq__grid { grid-template-columns: minmax(0, 1fr); row-gap: 2rem; }
  }
</style>

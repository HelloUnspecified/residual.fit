---
import DayRing from './DayRing.astro';
import MacroBar from './MacroBar.astro';
import { rows, breakfast, lunch, ahead } from '../scripts/demo-day.js';
import { kcal, forecast } from '../scripts/solve.js';
import '../styles/today.css';

// Today, working, at the size it is on an iPhone. The page is rendered at "lunch as planned", so it reads
// right without script; the words and the states are the app's own (TodayState in its Kit, DESIGN.md §7).
const sum = (foods: any[], grams: number[]) => { let p = 0, c = 0, f = 0; foods.forEach((x, i) => { const g = grams[i] / 100; p += x.per100[0] * g; c += x.per100[1] * g; f += x.per100[2] * g; }); return { p, c, f, cal: kcal(p, c, f) }; };
const L = sum(lunch, lunch.map((x) => x.ref));
const A = sum(ahead, ahead.map((x) => x.ref));
const logged = { p: breakfast.p + L.p, c: breakfast.c + L.c, f: breakfast.f + L.f, cal: 0 };
logged.cal = kcal(logged.p, logged.c, logged.f);
const total = { p: logged.p + A.p, c: logged.c + A.c, f: logged.f + A.f, cal: logged.cal + A.cal };
const status = forecast(rows, total);
const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
const macros = (m: { p: number; c: number; f: number }) => `${Math.round(m.p)}P · ${Math.round(m.c)}C · ${Math.round(m.f)}F`;
const cal = rows[0];
const mealsAhead = ['Snack', 'Dinner'].map((name) => {
  const foods = ahead.filter((f) => f.meal === name);
  const m = sum(foods, foods.map((f) => f.ref));
  return { name, cal: m.cal, line: macros(m) };
});
const bars = rows.slice(1).map((r) => ({ macro: r.key, name: r.key === 'p' ? 'Protein' : r.key === 'c' ? 'Carbs' : 'Fat', target: r.target, tol: r.tol, floats: r.floats, planned: (total as any)[r.key], eaten: (logged as any)[r.key] }));
---
<section id="live" class="live wrap" aria-labelledby="live-title">
  <div class="frame">
    <h2 id="live-title" class="head live__title" data-reveal><span data-word>Lunch as planned.</span> <span data-word2>Nothing moves.</span></h2>

    <div class="live__grid">
      <div class="live__copy" data-reveal style="--i:1">
        <p class="lead">Drag the chicken to what you really ate. Stay inside your range and nothing needs to move. Leave it, and one button re-sizes what's left.</p>

        <div class="amount" data-ui>
          <div class="amount__head"><strong>Chicken breast, cooked</strong><span class="nums">Plan 200 g</span></div>
          <div class="amount__row">
            <button type="button" class="amount__btn" data-step="-5" aria-label="5 grams less"><span aria-hidden="true">−</span></button>
            <output class="amount__value nums" for="live-grams"><span data-grams>200</span> g</output>
            <button type="button" class="amount__btn" data-step="5" aria-label="5 grams more"><span aria-hidden="true">+</span></button>
          </div>
          <label class="amount__slider">
            <span class="sr-only">Chicken eaten at lunch, grams</span>
            <input id="live-grams" type="range" min="100" max="400" step="5" value="200" />
          </label>
          <p class="amount__foot">With white rice 250 g and olive oil 10 g.</p>
        </div>

        <p class="small muted live__rules">A port of the app's solver, running in your browser. How it decides: calories first, then protein, then carbs; fat floats; nothing shrinks below half its plan or grows past double; portions on a 5 g grid. Nothing changes until you press the button.</p>
      </div>

      <div class="today" data-ui data-reveal="scale" style="--i:2" aria-live="polite">
        <div class="today__hero">
          <div class="today__ring">
            <DayRing id="live-ring" target={cal.target} tol={cal.tol} planned={total.cal} eaten={logged.cal} label="The day's calories: eaten, planned, and the range around the target." />
            <div class="today__center nums"><strong data-number>{fmt(logged.cal)}</strong><span>of {fmt(cal.target)} kcal</span></div>
          </div>
          <div class="today__bars">
            {bars.map((b) => <MacroBar {...b} />)}
          </div>
        </div>

        <p class="verdict" data-tone={status.worst ? 'warn' : 'good'}><strong data-lead>Lands in range.</strong> <span data-detail>Two meals ahead, sized to fit.</span></p>

        <h3 class="today__kicker">Your day</h3>
        <ul class="today__rows">
          <li class="row">
            <span class="row__mark"></span>
            <div class="row__line"><strong>Breakfast</strong><span class="nums">{fmt(breakfast.cal)} kcal</span></div>
            <div class="row__line row__sub nums"><span>{macros(breakfast)}</span></div>
          </li>
          <li class="row" data-lunch>
            <span class="row__mark"></span>
            <div class="row__line"><strong>Lunch</strong><span class="nums" data-lunch-kcal>{fmt(L.cal)} kcal</span></div>
            <div class="row__line row__sub nums"><span data-lunch-macros>{macros(L)}</span><span class="chip" data-chip hidden></span></div>
          </li>
          {mealsAhead.map((m) => (
            <li class="row row--ahead" data-meal={m.name}>
              <span class="row__mark"></span>
              <div class="row__line"><strong>{m.name}</strong><span class="nums" data-kcal>{fmt(m.cal)} kcal</span></div>
              <div class="row__line row__sub nums"><span data-macros>{m.line}</span></div>
              <ul class="row__foods nums" data-foods hidden></ul>
            </li>
          ))}
        </ul>

        <div class="today__action">
          <button type="button" class="pill" data-pill data-tone="key" disabled>
            <span class="pill__title" data-pill-title>Log snack</span>
            <span class="pill__detail" data-pill-detail hidden></span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { solve, kcal, forecast, LABEL } from '../scripts/solve.js';
  import { rows, breakfast, lunch, ahead } from '../scripts/demo-day.js';
  import { setRing, setBar } from '../scripts/live-day.js';

  const root = document.getElementById('live')!;
  const input = root.querySelector<HTMLInputElement>('#live-grams')!;
  const ring = root.querySelector<SVGSVGElement>('#live-ring')!;
  const fragment = root.querySelector<HTMLElement>('.today')!;
  const pill = root.querySelector<HTMLButtonElement>('[data-pill]')!;
  const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
  const macros = (m: { p: number; c: number; f: number }) => `${Math.round(m.p)}P · ${Math.round(m.c)}C · ${Math.round(m.f)}F`;
  const sum = (foods: any[], grams: number[]) => { let p = 0, c = 0, f = 0; foods.forEach((x, i) => { const g = grams[i] / 100; p += x.per100[0] * g; c += x.per100[1] * g; f += x.per100[2] * g; }); return { p, c, f, cal: kcal(p, c, f) }; };

  const planLunch = sum(lunch, lunch.map((x) => x.ref));
  const planned = ahead.map((f) => f.ref);
  // What the meals ahead are sized to right now: the plan until the button is pressed. Like plannedGrams in the
  // app, it's the solver's output; the solver itself always starts from the plan's amounts, its stable anchor.
  let current = planned.slice();
  let closed = false;

  const render = () => {
    const grams = Number(input.value);
    const L = sum(lunch, [grams, 250, 10]);
    const logged = { p: breakfast.p + L.p, c: breakfast.c + L.c, f: breakfast.f + L.f };
    const loggedCal = kcal(logged.p, logged.c, logged.f);
    const open = sum(ahead, current);
    const total = { p: logged.p + open.p, c: logged.c + open.c, f: logged.f + open.f, cal: loggedCal + open.cal };
    const status = forecast(rows, total);
    const off = status.severity !== 'onTrack';
    const tone = off ? 'warn' : 'good';
    const fix = off ? solve(rows, logged, ahead) : null;
    const canClose = fix !== null && fix.grams.some((g: number, i: number) => g !== current[i]);

    // The hero.
    root.querySelector('[data-grams]')!.textContent = String(grams);
    input.setAttribute('aria-valuetext', `${grams} grams`);
    const cal = rows[0];
    setRing(ring as any, { target: cal.target, tol: cal.tol, planned: total.cal, eaten: loggedCal, tone });
    const number = root.querySelector<HTMLElement>('[data-number]')!;
    number.textContent = fmt(loggedCal);
    number.dataset.off = status.worst?.key === 'cal' ? 'true' : 'false';
    for (const row of rows.slice(1)) {
      const el = root.querySelector<HTMLElement>(`[data-macro="${row.key}"]`)!;
      const value = (total as any)[row.key];
      const outside = !row.floats && Math.abs(row.target - value) > row.tol;
      setBar(el, { target: row.target, tol: row.tol, planned: value, eaten: (logged as any)[row.key], off: outside ? 'warn' : undefined });
    }

    // The verdict: the first broken target leads, as in the app.
    const verdict = root.querySelector<HTMLElement>('.verdict')!;
    verdict.dataset.tone = tone;
    const worst = status.worst;
    const line = worst ? `${LABEL[worst.key as keyof typeof LABEL]} ${worst.gap >= 0 ? 'short' : 'over'} ${fmt(Math.abs(worst.gap))}${worst.key === 'cal' ? '' : ' g'}.` : 'Lands in range.';
    root.querySelector('[data-lead]')!.textContent = line;
    root.querySelector('[data-detail]')!.textContent = !off ? 'Two meals ahead, sized to fit.' : canClose ? 'Two meals ahead can absorb it.' : 'As close as it gets · two meals ahead.';

    // Lunch: the real number stays as it is. As in the app since 1.0.2 (OffPlanWords, DayComponents), the chip
    // says "Off plan" and by how much at any drift, and the line turns amber only once the meal's own drift is
    // past a band of the day (Meal.departs: calories or any macro, fat included).
    root.querySelector('[data-lunch-kcal]')!.textContent = `${fmt(L.cal)} kcal`;
    root.querySelector('[data-lunch-macros]')!.textContent = macros(L);
    const lunchRow = root.querySelector<HTMLElement>('[data-lunch]')!;
    const chip = root.querySelector<HTMLElement>('[data-chip]')!;
    const delta = Math.round(L.cal - planLunch.cal);
    const departs = Math.abs(L.cal - planLunch.cal) > rows[0].tol || Math.abs(L.p - planLunch.p) > rows[1].tol || Math.abs(L.c - planLunch.c) > rows[2].tol || Math.abs(L.f - planLunch.f) > rows[3].tol;
    chip.hidden = delta === 0;
    chip.textContent = `Off plan · ${delta > 0 ? '+' : '−'}${fmt(Math.abs(delta))} kcal`;
    lunchRow.classList.toggle('row--diverged', delta !== 0 && departs);

    // The meals ahead, and what the solve changed in them until the amounts change again.
    for (const name of ['Snack', 'Dinner']) {
      const row = root.querySelector<HTMLElement>(`[data-meal="${name}"]`)!;
      const idx = ahead.map((f, i) => (f.meal === name ? i : -1)).filter((i) => i >= 0);
      const foods = idx.map((i) => ahead[i]);
      const m = sum(foods, idx.map((i) => current[i]));
      // The number just ticks over to the new amount, as in the app (DayComponents, 2026-11-01, Clark: a green
      // "640 → 598" read as one more kind of divergence). The foods under it say what moved.
      row.querySelector<HTMLElement>('[data-kcal]')!.textContent = `${fmt(m.cal)} kcal`;
      row.querySelector('[data-macros]')!.textContent = macros(m);
      const list = row.querySelector<HTMLElement>('[data-foods]')!;
      const changed = idx.filter((i) => current[i] !== planned[i]);
      list.hidden = !closed || changed.length === 0;
      list.replaceChildren(...changed.map((i) => {
        const li = document.createElement('li');
        const food = document.createElement('span');
        food.textContent = ahead[i].name;
        const amount = document.createElement('span');
        amount.textContent = `${planned[i]} → ${current[i]} g`;
        li.append(food, amount);
        return li;
      }));
    }

    // The one button.
    pill.dataset.tone = canClose ? 'warn' : 'key';
    pill.disabled = !canClose;
    root.querySelector('[data-pill-title]')!.textContent = canClose ? 'Close the residual' : 'Log snack';
    const detail = root.querySelector<HTMLElement>('[data-pill-detail]')!;
    detail.hidden = !canClose;
    detail.textContent = 'Re-size the 2 meals ahead';

    // The heading says what just happened, in plain words.
    const word = root.querySelector('[data-word]')!, word2 = root.querySelector('[data-word2]')!;
    if (grams === 200 && !closed) { word.textContent = 'Lunch as planned.'; word2.textContent = 'Nothing moves.'; return; }
    const over = grams > 200;
    word.textContent = grams === 200 ? 'Lunch as planned.' : over ? 'Lunch ran over.' : 'Lunch ran short.';
    if (off) word2.textContent = canClose ? 'One button fixes it.' : 'That’s as close as it gets.';
    else if (closed && current.some((g, i) => g !== planned[i])) word2.textContent = over ? 'The rest of the day made room.' : 'The rest of the day filled in.';
    else word2.textContent = 'Still in range.';
    fragment.dataset.closed = String(closed);
  };

  input.addEventListener('input', () => { closed = closed && current.some((g, i) => g !== planned[i]); render(); });
  root.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => b.addEventListener('click', () => {
    input.value = String(Math.min(400, Math.max(100, Number(input.value) + Number(b.dataset.step))));
    input.dispatchEvent(new Event('input'));
  }));

  pill.addEventListener('click', () => {
    const L = sum(lunch, [Number(input.value), 250, 10]);
    const logged = { p: breakfast.p + L.p, c: breakfast.c + L.c, f: breakfast.f + L.f };
    const res = solve(rows, logged, ahead);
    current = res.grams;
    closed = true;
    render();
  });
  render();
</script>

<style>
  .live { margin-top: var(--section); }
  .live__title { max-width: 22ch; }
  .live__title span { display: block; }
  .live__grid { margin-top: clamp(2rem, 4vw, 3.5rem); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 27rem); column-gap: clamp(2rem, 7vw, 7rem); align-items: start; }
  .live__copy { position: sticky; top: 3rem; }
  .live__rules { margin-top: 1.5rem; max-width: 52ch; }

  /* The amount: the app's stepper, with a slider so a whole lunch can be dragged at once. */
  [data-ui].amount { margin-top: 2rem; max-width: 30rem; background: var(--card); border-radius: var(--radius-card); padding: 1.25rem 1.4rem 1.1rem; }
  [data-ui] .amount__head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; font-size: 1.0625rem; }
  [data-ui] .amount__head strong { font-weight: 600; }
  [data-ui] .amount__head span { color: var(--label2); font-size: 0.9375rem; white-space: nowrap; }
  [data-ui] .amount__row { display: grid; grid-template-columns: auto 1fr auto; align-items: center; margin-top: 0.75rem; }
  [data-ui] .amount__btn { width: 44px; height: 44px; border-radius: 50%; background: var(--note); color: var(--key); font-size: 1.5rem; line-height: 1; display: grid; place-items: center; transition: transform var(--t-press) var(--ease-out); }
  [data-ui] .amount__btn:active { transform: scale(0.92); }
  [data-ui] .amount__value { text-align: center; font-family: var(--font-mark); font-size: 2.75rem; font-weight: 600; letter-spacing: -0.03em; line-height: 1; }
  [data-ui] .amount__slider { display: block; margin-top: 1rem; }
  [data-ui] .amount__slider input { width: 100%; height: 44px; margin: 0; accent-color: var(--key); cursor: grab; }
  [data-ui] .amount__foot { margin-top: 0.1rem; color: var(--label2); font-size: 0.875rem; }

  @media (max-width: 64em) {
    .live__grid { grid-template-columns: minmax(0, 1fr); row-gap: 2.5rem; }
    .live__copy { position: static; }
  }
</style>

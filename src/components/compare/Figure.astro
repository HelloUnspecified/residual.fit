---
// The difference, drawn in HTML and CSS: an optional meal that went off plan, then what happens next in each app,
// side by side. It is an illustration, and its caption says so: the other app's side holds only what its sources
// support, in words, never a drawing of its screens; the numbers are Residual's own example day.
import Rich from './Rich.astro';
import type { Competitor, FigurePanel } from '../../content/compare/types';

interface Props {
  app: Competitor;
  number: (app: Competitor, id: string) => number | undefined;
}
const { app, number } = Astro.props;
const f = app.page.figure;
const panels: { panel: FigurePanel; cites: boolean }[] = [{ panel: f.them, cites: true }, { panel: f.us, cites: false }];
---
<figure class="drift">
  {f.event && (
    <div class="offrow">
      <span class="offrow__mark"></span>
      <div class="offrow__line"><strong>{f.event.name}</strong><span class="nums">{f.event.value}</span></div>
      <div class="offrow__line offrow__sub nums"><span>{f.event.sub}</span><span class="chip">{f.event.chip}</span></div>
    </div>
  )}
  <div class="drift__two">
    {panels.map(({ panel, cites }) => (
      <div class="then">
        <span class="kicker">{panel.kicker}</span>
        {panel.big && <div class="then__big nums"><strong>{panel.big.value}</strong><span>{panel.big.label}</span></div>}
        {panel.title && <span class="then__meal">{panel.title}</span>}
        {panel.rows && (
          <ul class="then__foods nums">
            {panel.rows.map((r) => (
              <li><span>{r.name}</span><span>{r.note && <span class="then__note">{r.note}</span>}{r.was && <s>{r.was}</s>}{r.value && <b>{r.value}</b>}</span></li>
            ))}
          </ul>
        )}
        {panel.notes?.map((n) => <p>{cites ? <Rich text={n} app={app} number={number} /> : <Rich text={n} />}</p>)}
        {panel.lands && <p class="then__lands nums">{cites ? <Rich text={panel.lands} app={app} number={number} /> : <Rich text={panel.lands} />}</p>}
      </div>
    ))}
  </div>
  <figcaption>{f.caption}</figcaption>
</figure>

<style>
  .drift { background: var(--card); border-radius: var(--radius-card); padding: clamp(1.1rem, 2.2vw, 1.75rem); display: grid; gap: 12px; }
  .drift figcaption { color: var(--label2); font-size: var(--step-small); line-height: 1.45; padding-inline: 4px; }
  /* The off-plan row, as Promises.astro draws it: amber here means what it means on Today, the day is off. */
  .offrow { position: relative; background: var(--bg); border-radius: var(--radius-row); padding: 12px 14px 12px 28px; font-size: 1.0625rem; line-height: 1.3; }
  .offrow__mark { position: absolute; left: 12px; top: 13px; bottom: 13px; width: 4px; border-radius: 2px; background: var(--amber); }
  .offrow__line { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  .offrow__line strong { font-weight: 600; }
  .offrow__line > .nums { font-size: 0.9375rem; font-weight: 600; }
  .offrow__sub { margin-top: 2px; font-size: 0.8125rem; color: var(--label2); align-items: center; }
  .chip { font-size: 0.75rem; font-weight: 600; padding: 2px 8px; border-radius: 999px; color: var(--amber); background: var(--amber-wash); white-space: nowrap; }

  .drift__two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 34em) { .drift__two { grid-template-columns: minmax(0, 1fr); } }
  .then { background: var(--bg); border-radius: var(--radius-row); padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 10px; }
  .kicker { font-family: var(--font-text); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--label3); }
  .then__big { display: grid; }
  .then__big strong { font-family: var(--font-mark); font-weight: 600; font-size: 2.5rem; line-height: 1; letter-spacing: -0.03em; }
  .then__big span { margin-top: 4px; font-size: 0.8125rem; font-weight: 500; color: var(--label2); }
  .then p { font-size: 0.9375rem; line-height: 1.4; color: var(--label2); }
  .then p + p { margin-top: 0; }
  .then__meal { font-size: 0.8125rem; font-weight: 600; color: var(--label2); }
  .then__foods { display: grid; font-size: 0.9375rem; line-height: 1.3; }
  .then__foods li { display: flex; justify-content: space-between; align-items: baseline; gap: 0.75rem; padding-block: 7px; }
  .then__foods li > span:last-child { text-align: right; }
  .then__foods li + li { border-top: 1px solid var(--separator); }
  .then__foods s { color: var(--label3); text-decoration-thickness: 1px; margin-right: 0.35rem; }
  .then__foods b { font-weight: 600; }
  .then__note { color: var(--label2); font-size: 0.8125rem; margin-right: 0.5rem; }
  .then__lands { margin-top: auto; font-size: 0.9375rem; line-height: 1.35; color: var(--label2); }
  .then__lands :global(strong) { color: var(--eaten); font-weight: 600; }
</style>

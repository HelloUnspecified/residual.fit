---
// /compare/<slug>/: Residual and one other app. Two equal cards say who should pick which; the difference is said
// and drawn; then the table for just the two, the prices with where they were read, switching, and the sources.
// Every word about the other app comes from its data file (content/compare/<slug>.ts) with its sources; the
// headings say "Residual and X", never "vs", and nothing here ranks either app.
import Rich from './Rich.astro';
import CompareTable from './CompareTable.astro';
import Sources from './Sources.astro';
import Figure from './Figure.astro';
import Close from './Close.astro';
import { competitors, residual, rows, numberSources, inWords, sourceAnchor } from '../../content/compare/index';
import type { Competitor } from '../../content/compare/types';

interface Props {
  app: Competitor;
}
const { app } = Astro.props;
const { number } = numberSources([app]);
const p = app.page;
const others = competitors.filter((a) => a !== app);
const priceSources = p.price.sources;
---
<div class="cmp-page wrap">
  <div class="frame">
    <section class="intro" aria-labelledby="page-title">
      <ol class="crumbs" aria-label="Breadcrumb"><li><a href="/compare/">Compare</a></li><li aria-current="page">{app.name}</li></ol>
      <h1 id="page-title" class="head">Residual and {app.name}</h1>
      <p class="lead"><Rich text={p.summary} app={app} number={number} /></p>
    </section>

    <div class="pair">
      <section class="side" aria-labelledby="pick-them">
        <h2 id="pick-them">Pick {app.name} if…</h2>
        <ul class="ticks">{p.pickThem.map((t) => <li><Rich text={t} app={app} number={number} /></li>)}</ul>
        <p class="side__note"><Rich text={p.pickThemNote} app={app} number={number} /></p>
      </section>
      <section class="side" aria-labelledby="pick-res">
        <h2 id="pick-res">Pick {residual.name} if…</h2>
        <ul class="ticks">{p.pickResidual.map((t) => <li><Rich text={t} /></li>)}</ul>
        <p class="side__note"><Rich text={p.pickResidualNote} /></p>
      </section>
    </div>

    <section class="block" aria-labelledby="differ-title">
      <h2 id="differ-title">{p.difference.heading}</h2>
      <div class="differ">
        <div class="differ__prose">
          {p.difference.paragraphs.map((t) => <p><Rich text={t} app={app} number={number} /></p>)}
        </div>
        <Figure app={app} number={number} />
      </div>
    </section>

    <section class="block" aria-labelledby="side-title">
      <h2 id="side-title">Side by side</h2>
      <p class="block__lead">The same {inWords(rows.length)} questions as the <a class="link" href="/compare/">overview</a>, in a few words each. Open any value with an arrow for the full detail and its source.</p>
      <CompareTable apps={[app]} caption={`Residual and ${app.name}`} note={`${app.name}’s facts checked ${app.checked}, on its own site, help pages or App Store listing.`} number={number} />
    </section>

    <section class="block" aria-labelledby="price-title">
      <h2 id="price-title">What they cost</h2>
      <div class="price-wrap">
        <div class="price">
          <h3>{app.name}</h3>
          <p class="price__main nums"><strong>{p.price.main}</strong><span>{p.price.per}</span></p>
          <p class="price__more nums">{p.price.more}</p>
          <p class="price__trial">{p.price.trial}</p>
          <p class="price__src">Checked {app.checked} on its {priceSources.map((s, i) => <>{i > 0 && (i === priceSources.length - 1 ? ' and ' : ', ')}<a class="link" href={`#${sourceAnchor(app, s.id)}`}>{s.label}</a></>)}.</p>
        </div>
        <div class="price">
          <h3>{residual.name}</h3>
          <p class="price__main nums"><strong>{residual.price.main}</strong><span>{residual.price.per}</span></p>
          <p class="price__more nums">{residual.price.more}</p>
          <p class="price__trial">{residual.price.trial}</p>
          <p class="price__src">From the <a class="link" href="/pricing/">pricing page</a>, which says where the money goes.</p>
        </div>
      </div>
      <p class="price-note">US prices. The App Store shows yours in your currency.</p>
    </section>

    <section class="block" aria-labelledby="switch-title">
      <h2 id="switch-title">Switching, or using both</h2>
      <div class="moves">
        <div class="move">
          <h3>Moving over</h3>
          <p><Rich text={p.switching.movingOver} app={app} number={number} /> {residual.fresh}</p>
        </div>
        <div class="move">
          <h3>Keeping both</h3>
          <p><Rich text={p.switching.keepingBoth} app={app} number={number} /></p>
        </div>
        <div class="move">
          <h3>Taking your data</h3>
          <p>{residual.takingYourData}</p>
        </div>
      </div>
    </section>

    <section class="block" aria-labelledby="src-title">
      <h2 id="src-title">Sources</h2>
      <p class="block__lead">Every fact about {app.name} comes from its own site, help pages or App Store listing, checked {app.checked}. Each entry says which rows and sentences it backs.</p>
      <div class="srcs"><Sources app={app} number={number} page="app" /></div>
      <p class="ours">Residual’s column describes version {residual.version}, from this site’s <a class="link" href="/features/">Features</a>, <a class="link" href="/pricing/">Pricing</a> and <a class="link" href="/privacy/">Privacy</a> pages.</p>
    </section>

    <section class="block" aria-labelledby="others-title">
      <h2 id="others-title">The other comparisons</h2>
      <div class="others">
        {others.map((o) => <a href={`/compare/${o.slug}/`}><span>Compare</span><strong>Residual and {o.name}</strong></a>)}
      </div>
    </section>

    <Close line={p.end} />
  </div>
</div>

<style>
  /* The same top padding as the documents, so the content sits under the absolute header. */
  .cmp-page { padding-top: 8rem; }
  .intro .head { max-width: 16ch; }
  .intro .lead { margin-top: 1.25rem; max-width: 44ch; }

  .crumbs { display: flex; flex-wrap: wrap; gap: 0.25rem; margin-bottom: 1.25rem; font-size: var(--step-small); color: var(--label2); }
  .crumbs li + li::before { content: '›'; margin-right: 0.35rem; color: var(--label3); }
  .crumbs a { color: var(--key); text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; text-underline-offset: 0.18em; }

  .block { margin-top: clamp(4.5rem, 9vw, 8rem); }
  .block > h2 { font-family: var(--font-head); font-weight: 500; font-size: var(--step-title); line-height: 1.15; letter-spacing: -0.02em; }
  .block__lead { margin-top: 0.75rem; color: var(--label2); font-size: 1.125rem; line-height: 1.55; max-width: 40rem; }

  /* Pick X if / Pick Residual if: two equal cards, the same parts in the same order. */
  .pair { margin-top: clamp(1.75rem, 3vw, 2.5rem); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 48em) { .pair { grid-template-columns: minmax(0, 1fr); } }
  .side { background: var(--card); border-radius: var(--radius-card); padding: clamp(1.25rem, 2.4vw, 2rem); }
  .side h2 { font-family: var(--font-head); font-weight: 500; font-size: var(--step-title); line-height: 1.15; letter-spacing: -0.02em; }
  .ticks { margin-top: 1.1rem; display: grid; }
  .ticks li { position: relative; padding: 0.7rem 0 0.7rem 1.4rem; font-size: 1.0625rem; line-height: 1.45; }
  .ticks li + li { border-top: 1px solid var(--separator); }
  .ticks li::before { content: ''; position: absolute; left: 0; top: 1.3rem; width: 0.4375rem; height: 0.4375rem; border-radius: 50%; background: var(--label3); }
  .side__note { margin-top: 1rem; color: var(--label2); font-size: var(--step-small); }

  /* The difference: the prose beside its drawing on a wide screen, above it on a narrow one. */
  .differ { margin-top: clamp(1.75rem, 3vw, 2.5rem); display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: start; }
  .differ__prose p { color: var(--label2); font-size: 1.125rem; line-height: 1.55; }
  .differ__prose p :global(strong) { color: var(--text); }
  @media (max-width: 64em) { .differ { grid-template-columns: minmax(0, 1fr); } }

  .price-wrap { margin-top: clamp(1.75rem, 3vw, 2.5rem); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 48em) { .price-wrap { grid-template-columns: minmax(0, 1fr); } }
  .price { background: var(--card); border-radius: var(--radius-card); padding: clamp(1.25rem, 2.4vw, 2rem); display: flex; flex-direction: column; gap: 0.35rem; }
  .price h3 { font-size: 1rem; font-weight: 600; color: var(--label2); }
  .price__main { margin-top: 0.4rem; display: grid; }
  .price__main strong { font-family: var(--font-mark); font-size: clamp(2rem, 1.6rem + 1.4vw, 2.75rem); font-weight: 600; letter-spacing: -0.03em; line-height: 1.1; }
  .price__main span { font-size: 1rem; }
  .price__more { color: var(--label2); font-size: 0.9375rem; }
  .price__trial { margin-top: 0.6rem; font-size: 0.9375rem; font-weight: 600; }
  .price__src { margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--separator); color: var(--label2); font-size: var(--step-small); }
  .price-note { margin-top: 1rem; color: var(--label2); font-size: var(--step-small); }

  .moves { margin-top: clamp(1.75rem, 3vw, 2.5rem); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 64em) { .moves { grid-template-columns: minmax(0, 1fr); } }
  .move { background: var(--card); border-radius: var(--radius-card); padding: clamp(1.25rem, 2.2vw, 1.75rem); }
  .move h3 { font-family: var(--font-head); font-weight: 500; font-size: 1.375rem; line-height: 1.2; letter-spacing: -0.015em; }
  .move p { margin-top: 0.5rem; color: var(--label2); font-size: 1rem; line-height: 1.5; }

  .srcs { margin-top: clamp(1.5rem, 3vw, 2rem); display: grid; grid-template-columns: minmax(0, 1fr); max-width: 46rem; }
  .ours { margin-top: 0.5rem; color: var(--label2); font-size: var(--step-small); max-width: 46rem; }

  .others { margin-top: clamp(1.5rem, 3vw, 2rem); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 48em) { .others { grid-template-columns: minmax(0, 1fr); } }
  .others a { display: grid; gap: 0.25rem; padding: 1.1rem 1.25rem 1.2rem; border-radius: var(--radius-row); background: var(--card); text-decoration: none; }
  .others span { font-size: var(--step-small); color: var(--label2); }
  .others strong { font-weight: 600; line-height: 1.3; color: var(--key); }
  @media (hover: hover) and (pointer: fine) {
    .others a:hover strong { text-decoration: underline; text-underline-offset: 0.18em; }
  }
</style>

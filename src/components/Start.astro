---
import { site } from '../site';
---
<section id="start" class="start wrap" aria-labelledby="start-title">
  <div class="frame start__grid">
    <div class="start__copy" data-reveal>
      <h2 id="start-title" class="head">Start with your numbers.</h2>
      <p class="lead">Bring the numbers your coach gave you, or let Residual work them out from your body, activity and goal. Set them once, plan a day, and log what you ate. The first {site.trialDays} days are free.</p>
      <div class="start__actions"><a class="button" href={site.appStoreUrl}>Try it free for {site.trialDays} days</a></div>
    </div>
    <form class="targets" data-ui data-reveal="scale" style="--i:1" aria-label="Daily targets, as the app's setup screen shows them" onsubmit="return false">
      <div class="targets__seg" role="radiogroup" aria-label="How to set targets">
        <label><input type="radio" name="mode" value="manual" checked /><span>I have my numbers</span></label>
        <label><input type="radio" name="mode" value="guided" /><span>Suggest for me</span></label>
      </div>
      <p class="targets__hint" data-hint>Type the numbers your nutritionist or coach gave you.</p>
      <div class="targets__rows">
        <label class="trow"><span>Calories</span><input class="nums" type="number" inputmode="numeric" name="cal" value="2700" min="0" step="10" /><span class="unit">kcal</span><span class="tol">± <input class="nums" type="number" inputmode="numeric" name="tcal" value="100" min="0" aria-label="calorie range" /></span></label>
        <label class="trow"><span>Protein</span><input class="nums" type="number" inputmode="numeric" name="p" value="210" min="0" /><span class="unit">g</span><span class="tol">± <input class="nums" type="number" inputmode="numeric" name="tp" value="10" min="0" aria-label="protein range" /></span></label>
        <label class="trow"><span>Carbs</span><input class="nums" type="number" inputmode="numeric" name="c" value="230" min="0" /><span class="unit">g</span><span class="tol">± <input class="nums" type="number" inputmode="numeric" name="tc" value="25" min="0" aria-label="carb range" /></span></label>
        <label class="trow"><span>Fat <em>Floats</em></span><input class="nums" type="number" inputmode="numeric" name="f" value="104" min="0" /><span class="unit">g</span><span class="tol">± <input class="nums" type="number" inputmode="numeric" name="tf" value="15" min="0" aria-label="fat range" /></span></label>
      </div>
      <p class="targets__sum nums">Your macros add up to <strong data-sum>2,696</strong> kcal<span data-diff>, 4 under your calorie target. Fat floats, so it gives.</span></p>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('.targets');
  if (form) {
    const n = (name: string) => Number((form.elements.namedItem(name) as HTMLInputElement).value) || 0;
    const sum = form.querySelector('[data-sum]')!, diff = form.querySelector('[data-diff]')!, hint = form.querySelector('[data-hint]')!;
    const update = () => {
      const kcal = 4 * n('p') + 4 * n('c') + 9 * n('f');
      sum.textContent = Math.round(kcal).toLocaleString('en-US');
      const d = Math.round(kcal - n('cal'));
      diff.textContent = Math.abs(d) <= n('tcal') ? (d === 0 ? ', exactly your calorie target.' : `, ${Math.abs(d)} ${d < 0 ? 'under' : 'over'} your calorie target and inside its range. Fat floats, so it gives.`) : `, ${Math.abs(d)} ${d < 0 ? 'under' : 'over'} your calorie target. Calories land first; fat floats and gives.`;
      hint.textContent = (form.elements.namedItem('mode') as RadioNodeList).value === 'guided' ? 'Work them out from your body, activity, and goal; everything stays editable.' : 'Type the numbers your nutritionist or coach gave you.';
    };
    form.addEventListener('input', update);
    update();
  }
</script>

<style>
  .start { margin-top: var(--section); padding-bottom: var(--section); }
  .start__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 27rem); column-gap: clamp(2rem, 7vw, 7rem); align-items: center; }
  .start__copy h2 { max-width: 12ch; }
  .start__copy .lead { margin-top: 1.25rem; }
  .start__actions { margin-top: 2rem; }

  [data-ui].targets { display: grid; gap: 12px; font-size: 17px; line-height: 1.3; }
  [data-ui] .targets__seg { display: grid; grid-template-columns: 1fr 1fr; background: var(--track); border-radius: 12px; padding: 3px; }
  [data-ui] .targets__seg label { position: relative; }
  [data-ui] .targets__seg input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  [data-ui] .targets__seg span { display: block; text-align: center; padding: 7px 10px; border-radius: 9px; font-size: 14px; font-weight: 500; transition: background-color var(--t-ui) var(--ease-out); }
  [data-ui] .targets__seg input:checked + span { background: var(--card); font-weight: 600; }
  [data-ui] .targets__seg input:focus-visible + span { outline: 2px solid var(--key); }
  [data-ui] .targets__hint { color: var(--label2); font-size: 15px; padding-inline: 4px; }
  [data-ui] .targets__rows { display: grid; background: var(--card); border-radius: 20px; padding-inline: 16px; }
  [data-ui] .trow { display: grid; grid-template-columns: 1fr auto auto auto; align-items: center; gap: 6px; min-height: 56px; }
  [data-ui] .trow + .trow { border-top: 1px solid var(--separator); }
  [data-ui] .trow > span:first-child { font-weight: 600; }
  [data-ui] .trow em { font-style: normal; font-weight: 500; color: var(--label2); font-size: 13px; margin-left: 6px; }
  [data-ui] .trow input { width: 4.4em; min-height: 36px; background: var(--bg); border: 0; border-radius: 10px; padding: 0 8px; text-align: right; font-size: 16px; font-weight: 600; -moz-appearance: textfield; appearance: textfield; }
  [data-ui] .trow input::-webkit-inner-spin-button, [data-ui] .trow input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  [data-ui] .trow .tol input { width: 3.1em; font-weight: 500; }
  [data-ui] .trow .unit { color: var(--label2); font-size: 13px; width: 2.2em; }
  [data-ui] .trow .tol { color: var(--label2); font-size: 15px; display: inline-flex; align-items: center; gap: 4px; }
  [data-ui] .targets__sum { color: var(--label2); font-size: 15px; max-width: none; padding-inline: 4px; }
  [data-ui] .targets__sum strong { color: var(--text); font-weight: 600; }

  @media (max-width: 64em) {
    .start__grid { grid-template-columns: minmax(0, 1fr); row-gap: 2.5rem; }
  }
</style>

---
/** The calorie bar from Residual's Today hero, at full width: eaten, planned, the range, where it lands. */
interface Props { eaten?: number; lands?: number; tol?: number; target?: number; eatenLabel?: string; aheadLabel?: string }
const { eaten = 0.54, lands = 0.988, tol = 0.037, target = 2700, eatenLabel = 'Breakfast and lunch, eaten', aheadLabel = 'Dinner and a snack, still planned' } = Astro.props;
const pct = (f: number) => `${(f * 92 + 2).toFixed(2)}%`; // keep 2% either side for the caps and the zone past the tick
---
<div class="band wrap" role="img" data-reveal aria-label={`The day so far: ${Math.round(eaten * target)} kcal eaten, the plan lands at ${Math.round(lands * target)} of ${target}, inside a range of plus or minus ${Math.round(tol * target)}.`}>
  <p class="band__left"><strong>{eatenLabel}</strong> <span class="muted">then</span> <strong>{aheadLabel}</strong></p>
  <svg class="band__bar" width="100%" height="36" aria-hidden="true">
    <rect x={pct(1 - tol)} y="8" width={`${(2 * tol * 92).toFixed(2)}%`} height="20" fill="var(--green)" fill-opacity="0.28" />
    <line x1="2%" x2="94%" y1="18" y2="18" stroke="var(--surface-2)" stroke-width="10" stroke-linecap="round" />
    <line x1={pct(eaten)} x2={pct(lands)} y1="18" y2="18" stroke="var(--accent)" stroke-width="6" stroke-linecap="round" stroke-dasharray="0.1 14" />
    <line x1="2%" x2={pct(eaten)} y1="18" y2="18" stroke="var(--green)" stroke-width="10" stroke-linecap="round" />
    <rect x="94%" y="4" width="3" height="28" fill="var(--ink)" transform="translate(-1.5 0)" />
    <circle cx={pct(lands)} cy="18" r="9" fill="var(--bg)" />
    <circle cx={pct(lands)} cy="18" r="6.5" fill="var(--green)" />
  </svg>
  <p class="band__right nums"><strong>lands {Math.round(lands * target).toLocaleString('en-US')}</strong> <span class="muted">of {target.toLocaleString('en-US')} kcal, range ±{Math.round(tol * target)}</span></p>
</div>

<style>
  .band { display: grid; gap: 0.6rem; padding-block: clamp(3rem, 7vw, 6rem); }
  .band__bar { overflow: visible; }
  .band__right { text-align: right; }
  @media (min-width: 48em) {
    .band { grid-template-columns: 1fr auto; grid-template-areas: 'l r' 'bar bar'; align-items: end; }
    .band__left { grid-area: l; } .band__right { grid-area: r; } .band__bar { grid-area: bar; }
  }
</style>

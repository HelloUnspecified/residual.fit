---
// Everything else the app does, as two-ended rows: the feature on the left, the plain fact on the right. Each is
// checked against the app; the names are its own where it has one.
const groups = [
  { name: 'Today', rows: [
    ['Gauges', 'Eaten, Landing, Left, Plan, Clock'],
    ['Widgets', 'Six, Home and Lock Screen'],
    ['Meal times', 'Shown on the row and the Clock'],
    ['Notes', 'Never counted, never sent'],
    ['Fiber', 'Shown, never a target'],
    ['Reorder', 'Drag meals and notes'],
    ['Lock', 'A logged meal stays as it is'],
    ['Share your day', 'Story, square, sticker, numbers'],
  ] },
  { name: 'Your food', rows: [
    ['USDA food search', 'Your foods first'],
    ['Barcode scanning', 'Packaged foods'],
    ['Nutrition label', 'Read on your iPhone'],
    ['Match to USDA', 'You pick every match'],
    ['Recipes', 'A weighed dish, one food'],
    ['Units', 'g · oz · cup · tbsp · tsp · mL · fl oz'],
    ['Drinks', 'Alcohol counted, never a target'],
    ['Food library', 'Everything you’ve used'],
  ] },
  { name: 'Planning', rows: [
    ['Who plans', 'Claude, your iPhone, or your foods'],
    ['Only plan from my pantry', 'One switch'],
    ['Copy to other days', 'Across the next two weeks'],
    ['Saved meals', 'With a note and a source'],
    ['Plan the rest', 'Around what you’ve eaten'],
    ['Suggest a fix', 'From what you have'],
    ['Foods to avoid', 'Nine common allergies, one tap'],
    ['Grocery list', 'By aisle, checks off'],
  ] },
  { name: 'Targets', rows: [
    ['Ranges', '± on every target'],
    ['Floating', 'Any of them'],
    ['Landing order', 'Yours to set'],
    ['Portion rounding', 'Exact, 1, 5 or 10 g'],
    ['TDEE calculator', 'Every step shown'],
  ] },
  { name: 'Your data', rows: [
    ['Account', 'None'],
    ['Sync', 'Your own iCloud'],
    ['Offline', 'Plan, log and solve'],
    ['Export', 'CSV, one row per food'],
    ['Tracking and ads', 'None'],
  ] },
  { name: 'Getting started', rows: [
    ['Practice day', 'Nothing saved'],
    ['Guides', 'Eight, in Learn Residual'],
    ['Starter foods', 'A pantry and saved meals to begin with'],
    ['Appearance', 'Match iPhone, light, dark'],
  ] },
];
---
<section class="rest wrap" aria-labelledby="rest-title">
  <div class="frame">
    <h2 id="rest-title" class="head" data-reveal>And the rest</h2>
    <div class="rest__groups">
      {groups.map((g) => (
        <div class="rest__group" data-reveal>
          <h3>{g.name}</h3>
          <ul>
            {g.rows.map(([name, value]) => <li><span>{name}</span><span class="rest__value nums">{value}</span></li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Settings' grouped lists: a label over a card of two-ended rows. Two columns on a wide screen, so the whole
     inventory is one glance; one on a phone. */
  .rest { margin-top: var(--section); }
  .rest__groups { margin-top: clamp(2rem, 4vw, 3rem); columns: 2; column-gap: 12px; }
  .rest__group { break-inside: avoid; padding-bottom: 1.75rem; }
  .rest__group h3 { font-size: 0.9375rem; font-weight: 600; color: var(--label2); margin: 0 0 0.5rem 1rem; }
  .rest__group ul { list-style: none; margin: 0; padding: 0.25rem 1rem; background: var(--card); border-radius: var(--radius-card); }
  .rest__group li { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding-block: 0.7rem; font-size: 1rem; }
  .rest__group li + li { border-top: 1px solid var(--separator); }
  .rest__value { font-size: 0.875rem; color: var(--label2); text-align: right; }
  @media (max-width: 64em) {
    .rest__groups { columns: 1; }
  }
</style>

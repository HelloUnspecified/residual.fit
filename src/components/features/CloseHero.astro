---
import DayRing from '../DayRing.astro';
import MacroBar from '../MacroBar.astro';
import { site } from '../../site';
import '../../styles/today.css';

// The screenshot day from the app (2,100 kcal, 150 P, 220 C, 70 F with fat floating): breakfast and a lunch that
// ran over are logged, the snack and dinner are still planned. Every number here, including the result of Close
// the residual, is the app's own, read off its captures (scripts/screenshots/capture.sh: 03a-drift, 03b-review,
// 03c-after), so this fragment shows what the app really does on that day. The home page's LiveSolve is the one
// that computes in the browser.
const target = 2100, tol = 100;
const eaten = 1264, landsBefore = 2293, landsAfter = 2200;
const before = { p: 157, c: 238, f: 79 }, after = { p: 155, c: 236, f: 71 }, logged = { p: 91, c: 144, f: 36 };
const targets = { p: [150, 10], c: [220, 25], f: [70, 15] };
const meals = [
  { name: 'Snack', macros: '20P · 38C · 11F', kcal: 333, time: '3:30 PM', after: { macros: '19P · 35C · 9F', kcal: 295 } },
  { name: 'Dinner', macros: '46P · 56C · 32F', kcal: 696, time: '6:30 PM', after: { macros: '44P · 56C · 26F', kcal: 641 } },
];
const changes = [
  { meal: 'Snack', foods: [{ name: 'Apple, Fuji', from: 180, to: 170 }, { name: 'Peanut butter', from: 20, to: 15 }] },
  { meal: 'Dinner', foods: [{ name: 'Salmon, baked', from: 170, to: 165 }, { name: 'Olive oil', from: 10, to: 5 }] },
];
const lands = [
  { label: 'Calories', value: '2,200 / 2,100' },
  { label: 'Protein', value: '155 g / 150 g' },
  { label: 'Carbs', value: '236 g / 220 g' },
  { label: 'Fat', value: '71 g · floats', floats: true },
];
const fmt = (n: number) => n.toLocaleString('en-US');
const m = (k: 'p' | 'c' | 'f', planned: number) => ({ target: targets[k][0], tol: targets[k][1], planned, eaten: logged[k] });
---
<section class="hero wrap" aria-labelledby="hero-title">
  <div class="frame hero__grid">
    <div class="hero__copy">
      <h1 id="hero-title" class="display" data-rise style="--i:0">Off plan? Close the residual.</h1>
      <p class="lead" data-rise style="--i:1">Real food is never exact. When lunch runs over, Residual re-sizes the meals still ahead by the smallest change that lands your day. Press the button and see.</p>
      <div class="hero__actions" data-rise style="--i:2">
        <a class="button" href={site.appStoreUrl}>Try it free for {site.trialDays} days</a>
        <a class="link" href="#plan">See what else it does</a>
      </div>
    </div>

    <div class="hero__stage" data-rise style="--i:3">
      <div class="today" data-ui data-closehero aria-label="Residual's Today screen, working: lunch ran over, and Close the residual re-sizes the snack and dinner.">
        <div class="today__hero">
          <div class="today__ring">
            <DayRing id="close-ring" target={target} tol={tol} planned={landsBefore} eaten={eaten} tone="warn" label="The day's calories: eaten, planned, and the range around the target." />
            <div class="today__center nums"><strong data-number data-off="true">{fmt(eaten)}</strong><span>of {fmt(target)} kcal</span></div>
          </div>
          <div class="today__bars">
            <MacroBar macro="p" name="Protein" {...m('p', before.p)} />
            <MacroBar macro="c" name="Carbs" {...m('c', before.c)} />
            <MacroBar macro="f" name="Fat" {...m('f', before.f)} floats />
          </div>
        </div>

        <p class="verdict" data-tone="warn"><strong data-lead>Calories over 193.</strong> <span data-detail>Two meals ahead can absorb it.</span></p>

        <h2 class="today__kicker">Your day</h2>
        <ul class="today__rows">
          <li class="row">
            <span class="row__mark"></span>
            <div class="row__line"><strong>Breakfast</strong><span class="nums">465 kcal</span></div>
            <div class="row__line row__sub nums"><span>33P · 56C · 12F</span><span>7:30 AM</span></div>
          </li>
          <li class="row row--diverged">
            <span class="row__mark"></span>
            <div class="row__line"><strong>Lunch</strong><span class="nums">799 kcal</span></div>
            <div class="row__line row__sub nums"><span>58P · 88C · 24F</span><span class="chip">Off plan · +237 kcal</span></div>
          </li>
          {meals.map((f) => (
            <li class="row row--ahead" data-meal={f.name} data-after={JSON.stringify(f.after)}>
              <span class="row__mark"></span>
              <div class="row__line"><strong>{f.name}</strong><span class="nums" data-kcal>{f.kcal} kcal</span></div>
              <div class="row__line row__sub nums"><span data-macros>{f.macros}</span><span>{f.time}</span></div>
            </li>
          ))}
        </ul>

        <div class="today__action">
          <button type="button" class="pill" data-pill data-tone="warn" aria-haspopup="dialog">
            <span class="pill__title" data-pill-title>Close the residual</span>
            <span class="pill__detail" data-pill-detail>Re-size the 2 meals ahead</span>
          </button>
        </div>

        <div class="sheet" data-sheet role="dialog" aria-modal="false" aria-label="Close the residual" hidden>
          <div class="sheet__bar">
            <button type="button" class="sheet__cancel" data-cancel>Cancel</button>
            <strong>Close the residual</strong>
          </div>
          <div class="sheet__card">
            <p class="verdict" data-tone="good"><strong>Lands in range.</strong> Every target lands inside its range · nothing changes until Apply.</p>
            <ul class="nums sheet__lands">
              {lands.map((l) => <li class:list={{ 'is-float': l.floats }}><span>{l.label}</span><span>{l.value}</span></li>)}
            </ul>
          </div>
          <p class="sheet__note">Tap a food to keep it or set its amount. The rest re-sizes around it.</p>
          {changes.map((c) => (
            <div class="sheet__group">
              <h3>{c.meal}</h3>
              <ul class="nums">
                {c.foods.map((f) => <li><span>{f.name}</span><span>{f.from} → {f.to} g</span><span class="cut">−{f.from - f.to}</span></li>)}
              </ul>
            </div>
          ))}
          <button type="button" class="pill sheet__apply" data-apply data-tone="key">
            <span class="pill__title">Apply</span>
            <span class="pill__detail">Re-size 2 meals</span>
          </button>
        </div>
      </div>
      <button type="button" class="link hero__again" data-again hidden>Put lunch back and try it again</button>
    </div>
  </div>
</section>

<script>
  import { setRing, setBar } from '../../scripts/live-day.js';

  const root = document.querySelector<HTMLElement>('[data-closehero]');
  const stage = root?.closest<HTMLElement>('.hero__stage');
  if (root && stage) {
    const target = 2100, tol = 100, eaten = 1264;
    const targets = { p: [150, 10], c: [220, 25], f: [70, 15] } as const;
    const logged = { p: 91, c: 144, f: 36 };
    const days = { before: { lands: 2293, p: 157, c: 238, f: 79 }, after: { lands: 2200, p: 155, c: 236, f: 71 } };
    const sheet = root.querySelector<HTMLElement>('[data-sheet]')!;
    const again = stage.querySelector<HTMLElement>('[data-again]')!;
    const pill = root.querySelector<HTMLButtonElement>('[data-pill]')!;
    const ring = root.querySelector('#close-ring') as unknown as SVGSVGElement;
    const rows = [...root.querySelectorAll<HTMLElement>('[data-meal]')].map((li) => ({ li, kcal: li.querySelector('[data-kcal]')!.textContent!, macros: li.querySelector('[data-macros]')!.textContent!, after: JSON.parse(li.dataset.after!) }));

    const draw = (state: 'before' | 'after') => {
      const d = days[state];
      setRing(ring as any, { target, tol, planned: d.lands, eaten, tone: state === 'after' ? 'good' : 'warn' });
      root.querySelector<HTMLElement>('[data-number]')!.dataset.off = String(state === 'before');
      for (const k of ['p', 'c', 'f'] as const) {
        const el = root.querySelector<HTMLElement>(`[data-macro="${k}"]`)!;
        const outside = k !== 'f' && Math.abs(targets[k][0] - d[k]) > targets[k][1];
        setBar(el, { target: targets[k][0], tol: targets[k][1], planned: d[k], eaten: logged[k], off: outside ? 'warn' : undefined });
      }
      root.querySelector<HTMLElement>('.verdict')!.dataset.tone = state === 'after' ? 'good' : 'warn';
      root.querySelector('[data-lead]')!.textContent = state === 'after' ? 'Lands in range.' : 'Calories over 193.';
      root.querySelector('[data-detail]')!.textContent = state === 'after' ? 'Two meals ahead, sized to fit.' : 'Two meals ahead can absorb it.';
      for (const r of rows) {
        const k = r.li.querySelector<HTMLElement>('[data-kcal]')!;
        k.textContent = state === 'after' ? `${parseInt(r.kcal, 10)} → ${r.after.kcal}` : r.kcal;
        k.classList.toggle('is-receipt', state === 'after');
        r.li.querySelector('[data-macros]')!.textContent = state === 'after' ? r.after.macros : r.macros;
      }
      pill.dataset.tone = state === 'after' ? 'key' : 'warn';
      pill.disabled = state === 'after';
      root.querySelector('[data-pill-title]')!.textContent = state === 'after' ? 'Log snack' : 'Close the residual';
      root.querySelector<HTMLElement>('[data-pill-detail]')!.hidden = state === 'after';
      again.hidden = state !== 'after';
    };

    const open = () => { sheet.hidden = false; requestAnimationFrame(() => sheet.classList.add('is-open')); sheet.querySelector<HTMLElement>('[data-apply]')!.focus({ preventScroll: true }); };
    const shut = () => { sheet.classList.remove('is-open'); setTimeout(() => { sheet.hidden = true; }, 320); };
    pill.addEventListener('click', open);
    sheet.querySelector('[data-cancel]')!.addEventListener('click', () => { shut(); pill.focus({ preventScroll: true }); });
    sheet.querySelector('[data-apply]')!.addEventListener('click', () => { shut(); draw('after'); });
    again.addEventListener('click', () => { draw('before'); pill.focus({ preventScroll: true }); });
  }
</script>

<style>
  /* The copy on the left stays while the app's Today screen stands at its true size on the right, on the page's
     own ground: no frame and no panel behind it, the interface is the picture. */
  .hero { padding-top: clamp(6.5rem, 12vh, 9rem); }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 27rem); column-gap: clamp(2rem, 7vw, 7rem); align-items: start; }
  .hero__copy { position: sticky; top: 7rem; padding-top: 2vh; }
  .hero__copy h1 { max-width: 11ch; }
  .hero__copy .lead { margin-top: 1.5rem; max-width: 32ch; }
  .hero__actions { margin-top: 2rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; }
  .hero__stage { display: grid; gap: 1.2rem; justify-items: center; }
  .hero__again { justify-self: center; }

  /* The review sheet rises over the screen, the way the app presents it. */
  [data-ui] .sheet { position: absolute; inset: 0; z-index: 2; overflow: auto; background: var(--card); border-radius: 26px; padding: 14px 16px 16px; transform: translateY(102%); transition: transform 320ms var(--ease-out); box-shadow: 0 10px 30px rgb(0 0 0 / 0.18); }
  [data-ui] .sheet.is-open { transform: none; }
  [data-ui] .sheet[hidden] { display: none; }
  [data-ui] .sheet__bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; margin-bottom: 14px; }
  [data-ui] .sheet__bar strong { font-weight: 600; font-size: 17px; }
  [data-ui] .sheet__cancel { justify-self: start; padding: 8px 14px; min-height: 40px; border-radius: 999px; background: var(--bg); font-size: 15px; }
  [data-ui] .sheet__card { background: var(--bg); border-radius: 20px; padding: 14px 16px; }
  [data-ui] .sheet__card .verdict { margin: 0 0 8px; min-height: 0; font-size: 15px; }
  [data-ui] .sheet__lands li { display: flex; justify-content: space-between; gap: 10px; font-size: 14px; padding: 3px 0; }
  [data-ui] .sheet__lands li span:last-child { color: var(--eaten); }
  [data-ui] .sheet__lands .is-float, [data-ui] .sheet__lands .is-float span:last-child { color: var(--label2); }
  [data-ui] .sheet__note { margin: 10px 4px 0; font-size: 13px; color: var(--label2); max-width: none; }
  [data-ui] .sheet__group { margin-top: 12px; }
  [data-ui] .sheet__group h3 { font-family: var(--font-text); font-size: 15px; font-weight: 600; color: var(--label2); margin: 0 4px 6px; }
  [data-ui] .sheet__group ul { background: var(--bg); border-radius: 16px; padding-inline: 16px; }
  [data-ui] .sheet__group li { display: grid; grid-template-columns: 1fr auto 2.4rem; gap: 10px; padding: 9px 0; font-size: 15px; }
  [data-ui] .sheet__group li + li { border-top: 1px solid var(--separator); }
  [data-ui] .sheet__group .cut { color: var(--red); font-weight: 600; text-align: right; }
  [data-ui] .sheet__apply { margin-top: 14px; }

  @media (max-width: 64em) {
    .hero__grid { grid-template-columns: minmax(0, 1fr); row-gap: 3rem; }
    .hero__copy { position: static; }
    .hero__copy h1 { max-width: 13ch; }
  }
</style>

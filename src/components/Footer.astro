---
import { site } from '../site';
import Ring from './Ring.astro';
const year = new Date().getFullYear();
---
<footer class="foot wrap" aria-labelledby="foot-title">
  <div class="frame">
    <h2 id="foot-title" class="foot__mark"><Ring size="1.05em" /> Residual</h2>
    <div class="foot__links">
      <ul class="foot__col">
        <li><a class="nav-link" href="/#live">Try the solver</a></li>
        <li><a class="nav-link" href="/#gauges">The gauges</a></li>
        <li><a class="nav-link" href="/#how">How it works</a></li>
        <li><a class="nav-link" href="/features/">Features</a></li>
        <li><a class="nav-link" href="/pricing/">Pricing</a></li>
        <li><a class="nav-link" href="/#why">Why I built it</a></li>
        <li><a class="nav-link" href="/#questions">Questions</a></li>
      </ul>
      <ul class="foot__col">
        <li><a class="nav-link" href={site.appStoreUrl}>App Store</a></li>
        <li><a class="nav-link" href="/support/">Support</a></li>
        <li><a class="nav-link" href="/privacy/">Privacy</a></li>
        <li><a class="nav-link" href="/terms/">Terms of use</a></li>
        <li><a class="nav-link" href="/health-disclaimer/">Health disclaimer</a></li>
      </ul>
      <div class="foot__contact">
        <form class="foot__news" data-news novalidate>
          <label for="news-email">The Residual newsletter, by email.</label>
          <div class="foot__row">
            <input id="news-email" name="email" type="email" required autocomplete="email" inputmode="email" placeholder="you@example.com" />
            <button class="button" type="submit">Subscribe</button>
          </div>
          <p class="small muted" data-news-msg aria-live="polite">A few emails a month at most. Every one has an unsubscribe link.</p>
        </form>
        <p class="small muted">Made by {site.publisher}. <a class="link" href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a></p>
      </div>
    </div>
    <p class="small muted foot__last">© {year} {site.publisher}. Residual is <a class="link" href="/health-disclaimer/">not medical advice</a>; your targets come from you and your nutritionist.</p>
  </div>
</footer>

<script>
  // The newsletter sign-up: the same endpoint the app uses (src/pages/api/subscribe.ts), from the site's own origin.
  // It joins the newsletter alone; the app's joins product updates too (src/lib/mailingLists.ts).
  const form = document.querySelector<HTMLFormElement>('[data-news]');
  if (form) {
    const input = form.querySelector<HTMLInputElement>('input')!;
    const button = form.querySelector<HTMLButtonElement>('button')!;
    const msg = form.querySelector<HTMLElement>('[data-news-msg]')!;
    const say = (text: string, ok?: boolean) => { msg.textContent = text; msg.classList.toggle('is-ok', ok === true); msg.classList.toggle('is-err', ok === false); };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = input.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { say('That doesn’t look like an email address.', false); input.focus(); return; }
      button.disabled = true; say('Sending…');
      try {
        const res = await fetch('/api/subscribe', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email, source: 'site', lists: ['newsletter'] }) });
        const data = await res.json().catch(() => ({}));
        if (res.ok) { say('Check your inbox: click the link in our email to confirm your subscription.', true); form.reset(); }
        else say(data.error || 'Sign-up didn’t go through. Try again in a minute.', false);
      } catch { say('No connection. Try again in a minute.', false); }
      button.disabled = false;
    });
  }
</script>

<style>
  /* The close: the name, once, in the wordmark's own type, on a step of tone. */
  .foot { background: var(--card); padding-block: clamp(3rem, 6vw, 5rem) 2rem; }
  .foot__mark { display: flex; align-items: center; gap: 0.3em; font-family: var(--font-mark); font-weight: 600; font-size: clamp(2.5rem, 7vw, 5.5rem); line-height: 1; letter-spacing: -0.02em; }
  .foot__links { margin-top: 3rem; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 2rem; }
  .foot__col { display: grid; gap: 0.5rem; align-content: start; grid-column: span 3; font-size: 0.9375rem; }
  .foot__contact { grid-column: 7 / 13; display: grid; gap: 1.25rem; align-content: start; }
  .foot__news { display: grid; gap: 0.6rem; max-width: 30rem; }
  .foot__news label { font-weight: 500; }
  .foot__row { display: flex; gap: 0.5rem; }
  .foot__row input { flex: 1; min-width: 0; min-height: 2.75rem; padding: 0 1rem; background: var(--bg); border: 0; border-radius: 999px; color: var(--text); font-size: max(1rem, var(--step-small)); }
  .foot__row input::placeholder { color: var(--label3); }
  .foot__row .button { min-height: 2.75rem; padding-inline: 1.1rem; }
  .foot__news .is-ok { color: var(--eaten); }
  .foot__news .is-err { color: var(--amber); }
  .foot__last { margin-top: 3rem; max-width: none; }
  @media (max-width: 64em) {
    .foot__col { grid-column: span 6; }
    .foot__contact { grid-column: 1 / 13; }
  }
</style>

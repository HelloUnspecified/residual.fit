---
// One roadmap item, whatever stage it is in: a title, a sentence or two, then an optional note and an optional
// link. The stage decides how much it weighs (see Stage.astro), and its id is the anchor other pages link to.
import type { RoadmapItem } from '../../lib/roadmap.ts';
interface Props { item: RoadmapItem }
const { item } = Astro.props;
---
<li class={`item item--${item.stage}`} id={item.id}>
  <h3>{item.title}</h3>
  <p>{item.text}</p>
  {(item.note || item.link) && (
    <div class="item__meta">
      {item.note && <span class="note">{item.note}</span>}
      {item.link && <a class="link" href={item.link.href}>{item.link.label}</a>}
    </div>
  )}
</li>

<style>
  .item { scroll-margin-top: 6rem; }
  .item h3 { text-wrap: balance; }
  .item p { margin-top: 0.4rem; }
  .item__meta { margin-top: 0.85rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; font-size: var(--step-small); }
  /* "Needs Apple's review": a label, not a status color. A hairline pill in the secondary label, so it reads on
     a card, on the page's ground, and on the wash a linked item wears. */
  .note { display: inline-flex; align-items: center; min-height: 1.6rem; padding: 0 0.65rem; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--separator); color: var(--label2); font-size: 0.8125rem; font-weight: 600; line-height: 1.2; }

  /* Now: each item its own card, the title in Roundo at the title step. The most present thing on the page. */
  .item--now { background: var(--card); border-radius: var(--radius-card); padding: clamp(1.25rem, 2.6vw, 2rem); }
  .item--now h3 { font-family: var(--font-head); font-weight: 500; font-size: clamp(1.375rem, 1.2rem + 0.7vw, 1.75rem); line-height: 1.15; letter-spacing: -0.018em; }
  .item--now p { font-size: 1.125rem; line-height: 1.55; }

  /* Next: rows of one grouped card (the card is the list, in Stage.astro), split by hairlines as Settings does. */
  .item--next { padding-block: 1.25rem; }
  .item--next + .item--next { border-top: 1px solid var(--separator); }
  .item--next h3 { font-size: 1.1875rem; font-weight: 600; line-height: 1.3; }
  .item--next p { color: var(--label2); font-size: 1rem; line-height: 1.5; }

  /* Later: no card. Plain rows on the page's ground, the title and the sentence both in the secondary label. */
  .item--later { padding-block: 1rem; }
  .item--later + .item--later { border-top: 1px solid var(--separator); }
  .item--later:first-child { padding-top: 0.25rem; }
  .item--later h3 { font-size: 1.0625rem; font-weight: 600; line-height: 1.35; color: var(--label2); }
  .item--later p { color: var(--label2); font-size: 0.9375rem; line-height: 1.5; }

  /* Not planned: small tiles. Calm: the title and the reason, nothing louder. */
  .item--not-planned { background: var(--card); border-radius: var(--radius-card); padding: clamp(1.25rem, 2.2vw, 1.6rem); }
  .item--not-planned h3 { font-size: 1.125rem; font-weight: 600; line-height: 1.3; }
  .item--not-planned p { color: var(--label2); font-size: 1rem; line-height: 1.5; }

  /* Arriving from a link (/roadmap/#apple-health): the item wears the note wash, and with motion allowed it
     lands from a step darker. Rows in a group take the wash out to the card's edges, and the hairline under a
     washed row steps aside so the wash reads as one shape. */
  .item:target { background: var(--note); }
  .item:target h3 { color: var(--text); }
  .item--next:target { margin-inline: calc(-1 * clamp(1.25rem, 2.6vw, 2rem)); padding-inline: clamp(1.25rem, 2.6vw, 2rem); border-radius: var(--radius-row); }
  .item--later:target { margin-inline: -1rem; padding-inline: 1rem; padding-top: 1rem; border-radius: var(--radius-row); }
  .item--next:target + .item--next, .item--later:target + .item--later { border-top-color: transparent; }
  @media (prefers-reduced-motion: no-preference) {
    .item:target { animation: rm-land 1.6s var(--ease-soft); }
  }
  @keyframes rm-land { from { background: var(--track); } }
</style>

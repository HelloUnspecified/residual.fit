---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';

// What Residual costs and why. The prices come from site.plans; the monthly and daily figures are worked
// out from them here, so the page can't drift from the App Store. The comparisons in "Compare it to the
// right things" and the promises below (no tiers, no sales, no lifetime deal) must stay true to them.

const money = (n: number) => `$${n.toFixed(2)}`;
const cents = (n: number) => `${Math.round(n * 100)}¢`;
const monthly = site.plans[0];
const plans = site.plans.map((p) => {
  const perMonth = p.price / p.months;
  return {
    ...p,
    perMonth: money(perMonth),
    perDay: cents(p.price / (p.months * 30.4375)),
    saves: Math.round((1 - perMonth / monthly.price) * 100),
  };
});
const yearly = plans[plans.length - 1];
const perMeal = cents(yearly.price / 365.25 / 3);

// Where the money goes, as two-ended rows like the features inventory. The first group is every real bill;
// the second is every way an app usually pays them quietly, and Residual's answer to each.
const groups = [
  { name: 'What your subscription pays for', rows: [
    ['Claude', 'Paid to Anthropic, per plan'],
    ['Apple', 'Its share of every subscription'],
    ['The app', 'Built, fixed and improved'],
  ] },
  { name: 'What doesn’t', rows: [
    ['Ads', 'None'],
    ['Selling your data', 'None. We never collected it'],
    ['Sponsored foods', 'None'],
    ['Your account', 'There isn’t one'],
    ['Tracking and analytics', 'None'],
  ] },
];
---
<Layout title={`Pricing: ${site.trialDays}-day free trial, then ${money(monthly.price)} ${monthly.per}`} description={`What Residual costs and why: ${plans.map((p) => `${money(p.price)} ${p.per}`).join(', ')}, each with a ${site.trialDays}-day free trial. No free tier, no ads, no data sold.`} plain>
  <section class="intro wrap" aria-labelledby="pricing-title">
    <h1 id="pricing-title" class="head" data-rise style="--i:1">What Residual costs, and why.</h1>
    <p class="lead" data-rise style="--i:2">One subscription, Residual Plus, with everything in it. Three ways to pay for it, and every one starts with {site.trialDays} days free.</p>
  </section>

  <section class="plans wrap" aria-label="Plans">
    <ul class="plans__list">
      {plans.map((p, i) => (
        <li class:list={['plan', { 'plan--year': p === yearly }]} data-rise style={`--i:${i + 3}`}>
          <h2 class="plan__name">{p.name}</h2>
          <p class="plan__price nums"><strong>{money(p.price)}</strong> <span>{p.per}</span></p>
          <p class="plan__math nums">
            {p.months > 1 ? <>{p.perMonth} a month, about {p.perDay} a day</> : <>About {p.perDay} a day</>}
          </p>
          <p class="plan__note">{p.saves > 0 ? `${p.saves}% less than paying monthly` : 'Everything, month to month'}</p>
        </li>
      ))}
    </ul>
    <p class="plans__fine small muted" data-rise style="--i:6">US prices. The App Store shows yours in your currency, and Apple handles the payment. Every plan has every feature.</p>
  </section>

  <section class="money wrap" aria-labelledby="money-title">
    <h2 id="money-title" class="money__title" data-reveal>Where the money goes</h2>
    <p class="money__lead" data-reveal>Residual has two bills that grow with every person and every meal, and none of the usual ways of paying for them quietly.</p>
    <div class="money__groups">
      {groups.map((g) => (
        <div class="money__group" data-reveal>
          <h3>{g.name}</h3>
          <ul>
            {g.rows.map(([name, value]) => <li><span class="money__name">{name}</span><span class="money__value">{value}</span></li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <ol class="why">
    <li data-reveal>
      <h2>It isn’t a two-dollar app.</h2>
      <p>You open Residual at breakfast, at lunch, at the store and before dinner. Something you use that often, for something that matters that much, shouldn’t be priced like a flashlight, and it can’t be built like one. Apps that cost almost nothing are paid for somewhere else: by ads, by selling what they learn about you, or by being abandoned once the downloads level off. We won’t be any of those.</p>
    </li>
    <li data-reveal>
      <h2>You’re the customer, not the product.</h2>
      <p>Residual makes money one way: you pay for it. No ads, no data sold or shared, no sponsored foods slipped into your plan, no affiliate link to a meal kit. That keeps our interest and yours pointed the same way. We do well when your days land, the weight comes off, and you keep the app because it’s working, not because it’s hard to leave.</p>
    </li>
    <li data-reveal>
      <h2>Every plan costs us something.</h2>
      <p>When Claude plans your day, we pay Anthropic for that request.</p>
      <p>Those bills grow with every person and every meal, and they arrive every month. Your subscription is how they get paid, so nothing else has to be. Turn Claude off and the price is the same: planning on your iPhone, the solver, logging and everything else are all part of it.</p>
    </li>
    <li data-reveal>
      <h2>We can’t sell what we never collected.</h2>
      <p>There is no Residual account. Your targets, your days and what you eat live on your iPhone and in your own private iCloud. We never spent the money to build a way to collect them, so there is nothing to sell, leak or hand over, and that money went into the app instead. The <a class="link" href="/privacy/">privacy policy</a> lists every request that leaves your phone.</p>
    </li>
    <li data-reveal>
      <h2>Compare it to the right things.</h2>
      <p>Not to other apps. A year of Residual is {money(yearly.price)}: less than most single visits with a registered dietitian, and you get the plan every day instead of once. A month is {money(monthly.price)}: less than most gym memberships, and less than two takeout lunches. Paid yearly, it’s about {yearly.perDay} a day, or {perMeal} a meal.</p>
      <p>Then count the food you don’t throw out. Plan the week, and the grocery list buys what the plan uses, by the gram, and nothing more.</p>
    </li>
    <li data-reveal>
      <h2>The price is a bar we hold ourselves to.</h2>
      <p>Charging real money means you’ll expect real things: plans that land, numbers you can trust, fixes that come quickly. Good. That expectation is what keeps the app getting better. It’s also priced to last: enough to pay the bills and keep building for years, not a number picked to grow fast and sell the company, or your data, later.</p>
    </li>
    <li data-reveal>
      <h2>Less for committing. Nothing else off.</h2>
      <p>Quarterly costs {plans[1].saves}% less than paying monthly, and yearly {yearly.saves}% less. That isn’t a sale. It’s a thank-you for committing to a real stretch, because changing how you eat takes months, not weeks, and we’d rather plan for that with you.</p>
      <p>There are no tiers, no Pro on top of Plus, and no feature held back to sell you later. And no lifetime deal: Claude and the food lookups are bills that come every month, so a one-time price would be a promise we couldn’t keep.</p>
    </li>
    <li data-reveal>
      <h2>No sales, no tricks.</h2>
      <p>No Black Friday, no New Year’s deal, no countdown, no “sale ends Sunday”, no discount for pretending to cancel. Residual is worth the same in January as in July, so you’re never punished for joining on the wrong day. The price is the one your friends pay. If it ever changes, this page will say why before anyone is charged more.</p>
    </li>
    <li data-reveal>
      <h2>No free tier. A free trial.</h2>
      <p>There is no free version and no ad-supported one. A free app that calls Claude is still paid for, and the person paying is you, with your attention or your data. The free part is the trial: the whole app, for {site.trialDays} days of real meals. Long enough to plan a week, shop it, eat it and watch the residual close.</p>
      <p>Apple runs the trial; cancel at least 24 hours before it ends and you pay nothing. There are no reminder emails engineered to make you feel behind. Without an account, we couldn’t send one.</p>
    </li>
    <li data-reveal>
      <h2>Leaving is a setting.</h2>
      <p>Cancel in Settings → your name → Subscriptions. No email, no call, no exit survey. When it ends, the app locks, but your data stays yours: the lock screen still exports every day you logged to a spreadsheet.</p>
    </li>
  </ol>

  <div class="wrap"><p class="sign" data-reveal>— Clark</p></div>

  <section class="end wrap" aria-labelledby="end-title">
    <h2 id="end-title" data-reveal>{site.trialDays} days, then decide.</h2>
    <p data-reveal>Plan a real week with the whole app. If it isn’t worth {yearly.perDay} a day to you, cancel before the trial ends and you’ve paid nothing.</p>
    <div class="end__actions" data-reveal style="--i:1">
      <a class="button" href={site.appStoreUrl}>Try it free for {site.trialDays} days</a>
      <a class="link" href={`mailto:${site.supportEmail}?subject=Pricing`}>Ask about pricing</a>
    </div>
  </section>
  <Footer />
</Layout>

<style>
  /* One reading column, centered: what it costs, then why. */
  .wrap > * { max-width: 46rem; margin-inline: auto; }
  .intro { padding-top: clamp(8rem, 18svh, 11rem); }
  .intro h1 { max-width: 14ch; margin-inline: 0; }
  .intro > * { margin-inline: auto; }
  .intro .lead { margin-top: 1.5rem; }

  /* The three plans side by side, the same facts in the same order, so they compare at a glance. */
  .plans { margin-top: 3rem; }
  .plans__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .plan { background: var(--card); border-radius: var(--radius-card); padding: 1.4rem 1.25rem 1.5rem; display: grid; align-content: start; gap: 0.35rem; }
  .plan__name { font-size: 1rem; font-weight: 600; color: var(--label2); }
  .plan__price { margin-top: 0.4rem; display: grid; }
  .plan__price strong { font-family: var(--font-mark); font-size: clamp(2rem, 1.6rem + 1.4vw, 2.75rem); font-weight: 600; letter-spacing: -0.03em; line-height: 1.1; }
  .plan__price span { font-size: 1rem; }
  .plan__math { font-size: 0.9375rem; color: var(--label2); }
  .plan__note { margin-top: 0.8rem; font-size: 0.9375rem; font-weight: 600; color: var(--eaten); }
  .plan:first-child .plan__note { color: var(--label2); font-weight: 500; }
  .plans__fine { margin-top: 1rem; max-width: 46ch; margin-inline: 0; }

  /* The receipt: real bills on one side, the usual quiet revenue on the other, each answered. */
  .money { margin-top: var(--section); }
  .money__title, .why h2, .end h2 { font-family: var(--font-head); font-weight: 500; font-size: var(--step-title); line-height: 1.15; letter-spacing: -0.02em; }
  .money__lead { margin-top: 1rem; color: var(--label2); font-size: 1.125rem; line-height: 1.55; max-width: 35rem; }
  .money__groups { margin-top: 2.5rem; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .money__group ul { list-style: none; padding: 0.25rem 1rem; margin: 0; background: var(--card); border-radius: var(--radius-card); }
  .money__group h3 { font-size: 0.9375rem; font-weight: 600; color: var(--label2); margin: 0 0 0.5rem 1rem; }
  .money__group li { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding-block: 0.7rem; font-size: 1rem; }
  .money__group li + li { border-top: 1px solid var(--separator); }
  .money__value { font-size: 0.875rem; color: var(--label2); text-align: right; }

  /* The reasons: each a heading and a short paragraph, in the order the argument runs. */
  .why { margin-top: var(--section); padding-inline: var(--margin); list-style: none; }
  .why > li { max-width: 46rem; margin-inline: auto; }
  .why > li + li { margin-top: 4rem; }
  .why p { margin-top: 0.8rem; font-size: 1.125rem; line-height: 1.55; color: var(--label2); max-width: 40rem; }
  .why p + p { margin-top: 0.9em; }

  .sign { margin-top: 4rem; font-size: var(--step-lead); font-weight: 500; width: min(100%, 46rem); }

  /* The close, as on the features page: one sentence and one action on empty ground. */
  .end { padding-block: 16svh 14svh; }
  .end p { margin-top: 1rem; font-size: 1.125rem; line-height: 1.55; color: var(--label2); max-width: 35rem; }
  .end__actions { margin-top: 1.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; }

  @media (max-width: 64em) {
    .money__groups { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 48em) {
    .plans__list { grid-template-columns: minmax(0, 1fr); }
  }
</style>

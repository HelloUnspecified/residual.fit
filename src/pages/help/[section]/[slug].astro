---
// One help article: /help/<section>/<slug>/, from src/content/help/<section>/<slug>.md. Below 64em it's one
// column with the topics in a disclosure above the breadcrumb; from 64em the topics stand in a sticky sidebar;
// from 80em "On this page" joins on the right. Only the title, lead and body are indexed for search.
import HelpLayout from '../../../layouts/Help.astro';
import Topics from '../../../components/help/Topics.astro';
import ArticleBody from '../../../components/help/ArticleBody.astro';
import { loadHelp, isoDay, type HelpArticle } from '../../../lib/help';
import { site } from '../../../site';

export async function getStaticPaths() {
  const { ordered } = await loadHelp();
  return ordered.map((article) => ({ params: { section: article.section.id, slug: article.slug }, props: { id: article.id } }));
}

const { groups, ordered } = await loadHelp();
const index = ordered.findIndex((a) => a.id === Astro.props.id);
const article: HelpArticle = ordered[index];
const { data, section } = article;
// Previous and next run through the whole help in its order: a section's last article leads to the next's first.
const prev = ordered[index - 1];
const next = ordered[index + 1];
const html = article.rendered?.html ?? '';
const toc = (article.rendered?.metadata?.headings ?? []).filter((h) => h.depth === 2);

const url = (path: string) => new URL(path, Astro.site).href;
const canonical = url(article.url);
const breadcrumbs = {
  '@type': 'BreadcrumbList',
  '@id': `${canonical}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Help', item: url('/help/') },
    { '@type': 'ListItem', position: 2, name: section.name, item: url(`/help/#${section.id}`) },
    { '@type': 'ListItem', position: 3, name: data.title, item: canonical },
  ],
};
const mail = `mailto:${site.supportEmail}?subject=Residual`;
---
<HelpLayout title={`${data.title} · Help`} description={data.description} modified={isoDay(data.updated)} schema={[breadcrumbs]}>
  <div class="article-grid">
    <nav class="sidebar" aria-label="Help topics">
      <Topics groups={groups} current={article.id} />
    </nav>

    <article class="article">
      <details class="alltopics">
        <summary>All help topics <small>{section.name}</small><svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2 4.25 6 8.25l4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
        <nav class="alltopics__body" aria-label="Help topics">
          <Topics groups={groups} current={article.id} columns />
        </nav>
      </details>

      <nav class="crumbs-nav" aria-label="Breadcrumb">
        <ol class="crumbs">
          <li><a href="/help/">Help</a></li>
          <li><a href={`/help/#${section.id}`}>{section.name}</a></li>
        </ol>
      </nav>

      <div data-pagefind-body data-pagefind-meta={`section:${section.name}`}>
        <h1 data-pagefind-meta="description[data-description]" data-description={data.description}>{data.title}</h1>
        {data.lead && <p class="lead">{data.lead}</p>}
        <ArticleBody html={html} />
      </div>

      <footer class="article__foot">
        <p class="small muted">Applies to Residual {data.since} and later · Updated {data.updated}</p>
        {(prev || next) && (
          <nav class="pager" aria-label="Previous and next article">
            {prev && <a href={prev.url}><span>Previous</span><strong>{prev.data.title}</strong></a>}
            {next && <a class="pager__next" href={next.url}><span>Next</span><strong>{next.data.title}</strong></a>}
          </nav>
        )}
        <p class="article__stuck small muted">Still stuck? Write to <a class="link" href={mail}>{site.supportEmail}</a>, or in the app use <span class="path"><span>More</span><span>Support &amp; feedback</span></span>.</p>
      </footer>
    </article>

    {toc.length > 1 && (
      <aside class="toc" aria-labelledby="toc-title">
        <span class="kicker" id="toc-title">On this page</span>
        <ol>
          {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </aside>
    )}
  </div>
</HelpLayout>

<style>
  /* Phones and tablets in portrait: one column, the topics in a disclosure above the article. From 64em (iPad
     landscape, laptops) the topics stand in a sidebar; from 80em "On this page" sits on the right. */
  .article-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; align-items: start; }
  .sidebar, .toc { display: none; }
  @media (min-width: 64em) {
    .article-grid { grid-template-columns: 15rem minmax(0, 42rem); column-gap: clamp(2.5rem, 5vw, 4.5rem); }
    .sidebar { display: block; position: sticky; top: 2rem; max-height: calc(100vh - 4rem); overflow-y: auto; scrollbar-width: thin; padding: 0.25rem 0.25rem 1rem; margin: -0.25rem; }
    .alltopics { display: none; }
  }
  @media (min-width: 80em) {
    .article-grid { grid-template-columns: 15rem minmax(0, 42rem) 12rem; justify-content: space-between; }
    .toc { display: block; position: sticky; top: 2rem; }
  }

  .alltopics { background: var(--card); border-radius: var(--radius-row); padding-inline: clamp(1rem, 2vw, 1.5rem); }
  .alltopics summary { display: flex; justify-content: space-between; align-items: center; gap: 1rem; min-height: 3.25rem; cursor: pointer; list-style: none; font-weight: 600; }
  .alltopics summary::-webkit-details-marker { display: none; }
  .alltopics summary small { font-weight: 400; color: var(--label2); font-size: var(--step-small); margin-left: auto; text-align: right; }
  .alltopics summary svg { flex: none; color: var(--label3); }
  .alltopics[open] summary svg { transform: rotate(180deg); }
  .alltopics__body { padding: 0.5rem 0 1.25rem; border-top: 1px solid var(--separator); }

  .crumbs-nav { margin-top: 1.75rem; }
  @media (min-width: 64em) { .crumbs-nav { margin-top: 0; } }
  .crumbs { display: flex; flex-wrap: wrap; gap: 0.25rem; font-size: var(--step-small); color: var(--label2); }
  .crumbs li + li::before { content: '›'; margin-right: 0.35rem; color: var(--label3); }
  .crumbs a { color: var(--key); text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; text-underline-offset: 0.18em; }

  .article h1 { margin-top: 1rem; font-family: var(--font-head); font-weight: 500; font-size: clamp(2.25rem, 1.6rem + 2.4vw, 3.25rem); line-height: 1.05; letter-spacing: -0.024em; }
  .article .lead { margin-top: 1.25rem; max-width: none; color: var(--text); }

  .article__foot { margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid var(--separator); }
  .pager { margin-top: 1.5rem; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
  .pager a { display: grid; gap: 0.2rem; align-content: start; padding: 1rem 1.2rem; border-radius: var(--radius-row); background: var(--card); text-decoration: none; }
  .pager a span { font-size: var(--step-small); color: var(--label2); }
  .pager a strong { font-weight: 600; line-height: 1.3; color: var(--key); }
  .pager__next { text-align: right; grid-column: 2; }
  @media (max-width: 30em) {
    .pager { grid-template-columns: minmax(0, 1fr); }
    .pager__next { grid-column: 1; }
  }
  .article__stuck { margin-top: 1.5rem; }

  .toc .kicker { display: block; margin-bottom: 0.6rem; }
  .toc ol { list-style: none; margin: 0; display: grid; gap: 0.5rem; border-left: 1px solid var(--separator); padding-left: 0.9rem; }
  .toc a { color: var(--label2); text-decoration: none; font-size: var(--step-small); line-height: 1.35; display: block; }

  @media (hover: hover) and (pointer: fine) {
    .toc a:hover { color: var(--key); }
    .pager a:hover strong { text-decoration: underline; text-underline-offset: 0.18em; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .toc a { transition: color var(--t-hover) ease; }
    .alltopics summary svg { transition: transform var(--t-ui) var(--ease-out); }
  }
</style>

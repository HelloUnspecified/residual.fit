---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';
import { help } from '../content/support';

// The problems are drawn as one list where the first of them falls, under its own heading.
const problems = help.filter((h) => h.problem);
const sections = help.filter((h) => !h.problem || h === problems[0]);
const url = new URL(Astro.url.pathname, Astro.site).href;
const faqPage = {
  '@type': 'FAQPage',
  '@id': `${url}#faq`,
  isPartOf: { '@id': `${url}#webpage` },
  mainEntity: help.map((h) => ({
    '@type': 'Question', name: h.q,
    acceptedAnswer: { '@type': 'Answer', text: h.a.map((p) => p.replace(/<[^>]+>/g, '')).join('\n\n') },
  })),
};
---
<Layout title="Help: subscription, offline use, sync and data" description="Help with Residual: contact, the subscription, using it offline, planning with Claude, your data, and fixes for common problems." schema={[faqPage]} plain>
  <article class="doc wrap">
    <h1 class="head">Support</h1>
    <p class="lead">Write to <a class="link" href={`mailto:${site.supportEmail}?subject=Residual`}>{site.supportEmail}</a>. In the app, More → Support &amp; feedback opens the email with your app version, iOS version and iPhone model filled in.</p>
    <p>Writing from somewhere else? Say which iPhone and iOS version you have, and what you expected to happen.</p>

    {sections.map((h) => h.problem ? (
      <>
        <h2>Something isn't working</h2>
        <ul>
          {problems.map((p) => <li><strong>{p.q}</strong> <Fragment set:html={p.a.join(' ')} /></li>)}
        </ul>
      </>
    ) : (
      <>
        <h2>{h.q}</h2>
        {h.a.map((p) => <p set:html={p} />)}
      </>
    ))}
  </article>
  <Footer />
</Layout>

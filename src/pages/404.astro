---
// Served by Cloudflare Pages for any path that doesn't exist, with a real 404 status. Not indexed,
// not in the sitemap.
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Page not found" description="This page doesn't exist on residual.fit." noindex plain>
  <article class="doc wrap notfound">
    <h1 class="head">This page isn't here.</h1>
    <p class="lead">The link may be old or mistyped. The rest of the site is a short walk away.</p>
    <ul class="notfound__links">
      <li><a class="link" href="/">Home: what Residual does</a></li>
      <li><a class="link" href="/features/">Everything Residual does</a></li>
      <li><a class="link" href="/pricing/">What it costs, and why</a></li>
      <li><a class="link" href="/#live">Try the solver</a></li>
      <li><a class="link" href="/help/">Help: how Residual works</a></li>
      <li><a class="link" href="/support/">Contact support</a></li>
      <li><a class="link" href="/privacy/">Privacy policy</a></li>
      <li><a class="link" href="/terms/">Terms of use</a></li>
      <li><a class="link" href="/health-disclaimer/">Health disclaimer</a></li>
    </ul>
  </article>
  <Footer />
</Layout>

<style>
  .notfound__links { margin-top: 2rem; font-size: var(--step-lead); }
</style>

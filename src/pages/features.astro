---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import CloseHero from '../components/features/CloseHero.astro';
import SizedForYou from '../components/features/SizedForYou.astro';
import PlanYourWay from '../components/features/PlanYourWay.astro';
import AWeek from '../components/features/AWeek.astro';
import TheRest from '../components/features/TheRest.astro';
import { site } from '../site';

// What Residual does, shown by working pieces of the app rather than described. Each section is one
// component in components/features/, and each states what the app really does: when the app renames a
// button or changes a rule, change it there too.
---
<Layout title="Features: AI macro meal planner for iPhone" description="What Residual does: re-sizes the meals ahead when your day drifts, AI day plans shaped by you, five gauges, six widgets and grocery lists. No account." plain>
  <CloseHero />
  <SizedForYou />
  <PlanYourWay />
  <AWeek />
  <TheRest />
  <section class="end wrap" aria-label="Get Residual">
    <p data-reveal>Set your numbers once. Residual plans the day, and re-sizes it when real food doesn't match.</p>
    <div class="end__actions" data-reveal style="--i:1">
      <a class="button" href={site.appStoreUrl}>Try it free for {site.trialDays} days</a>
      <a class="link" href="/#questions">Read the questions</a>
    </div>
  </section>
  <Footer />
</Layout>

<style>
  .end { padding-block: 22svh 16svh; }
  .end > * { max-width: 46rem; margin-inline: auto; }
  .end p { font-family: var(--font-head); font-weight: 500; font-size: var(--step-head); line-height: 1.05; letter-spacing: -0.026em; }
  .end__actions { margin-top: 2rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; }
</style>

---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import CloseHero from '../components/features/CloseHero.astro';
import SizedForYou from '../components/features/SizedForYou.astro';
import PlanYourWay from '../components/features/PlanYourWay.astro';
import AWeek from '../components/features/AWeek.astro';
import TheRest from '../components/features/TheRest.astro';
import { site } from '../site';

// What Residual does, shown by working pieces of the app rather than described. Each section is one
// component in components/features/, and each states what the app really does: when the app renames a
// button or changes a rule, change it there too.
---
<Layout title="Features" description="What Residual does: Close the residual re-sizes the meals ahead when the day drifts, AI day plans shaped by you, shared meals sized to your day, grocery lists, logging, USDA foods and barcodes, and no account." plain>
  <CloseHero />
  <SizedForYou />
  <PlanYourWay />
  <AWeek />
  <TheRest />
  <section class="end wrap" aria-label="Get Residual">
    <p data-reveal>Set your numbers once. Residual plans the day, and keeps it landing.</p>
    <div class="end__actions" data-reveal style="--i:1">
      <a class="button" href={site.appStoreUrl}>Try it free for {site.trialDays} days</a>
      <a class="link" href="/#questions">Read the questions</a>
    </div>
  </section>
  <Footer />
</Layout>

<style>
  /* The close: one sentence and one action on empty ground, on the same text axis as the week. */
  .end { padding-block: 30svh 20svh; }
  .end > * { margin-left: clamp(0rem, 30vw - 6rem, 30vw); }
  .end p { font-size: var(--step-lead); line-height: 1.35; max-width: 30ch; }
  .end__actions { margin-top: 1.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; }
  .end__actions .link { font-weight: 500; }
  @media (max-width: 40em) { .end { padding-block: 20svh 14svh; } .end > * { margin-left: 0; } }
</style>
